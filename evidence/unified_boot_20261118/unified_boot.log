help


SLS Shell Commands:

  -- Session --

  login <uid> <gid>              change session credentials

  -- Object Catalog (Phase 1) --

  valloc <name> <type> <pages> [database]   allocate named persistent object

                                   type: 0=SYSTEM_META 1=DB_TABLE

                                         2=DB_INDEX    3=HEAP_BLOB

  vfree  <name>                  release a named object

  ls objects                     list all catalog entries

  stat   <name>                  show full details for an object

  object set database <name> <database|none>  retag any catalog object's database

  -- DB Records (Phase 1) --

  insert <object> <key> <value>  add a new record field

  update <object> <key> <value>  modify a field (stages to WAL if tx open)

  select <object> [<key>]        read one field, or all if key omitted

  delete <object> <key>          remove a field (blocked if append-only)

  -- Schema (Phase 6) --

  schema set <obj> <key> <type>  define field type (STRING|UINT64|FLOAT|BOOL)

  schema show <object>           dump schema + live values

  -- Schema Import/Export (SQL Feature-Parity Roadmap, Phase 8) --

  schema export                  dump CREATE TABLE/CREATE INDEX SQL for every readable table

  schema import <sql>            run ';'-separated CREATE TABLE/INDEX statements

  -- VectorStore Schema Import/Export (definitions only, no vector data) --

  vec schema export              dump COLLECTION/INDEX definitions for every readable collection

  vec schema import <text>       run COLLECTION/INDEX definition lines

  -- VectorStore Data Import/Export (the embeddings themselves) --

  vec data export <collection> [skip]   dump VECTOR lines (external_id + floats);

                                   skip resumes a walk once entries_remaining > 0

  vec data import <text>         run VECTOR lines (import schema first if restoring both)

  -- Security (Phase 2) --

  role set <uid> <role>          assign role (SYSTEM_KERNEL|DB_ADMIN|

                                              APP_USER|GUEST)

  grant  <uid> <object> <perm>   add perms (r|w|x|rw|rwx)

  revoke <uid> <object> <perm>   remove perms

  chmod  <name> <mask_hex>       set raw perm bitmask (legacy)

  -- Transactions (Phase 3) --

  tx begin                       open ACID transaction

  tx commit                      commit staged writes to WAL

  tx rollback                    discard staged writes

  wal dump                       print WAL entries

  wal recover                    replay WAL after simulated crash

  -- Journaling (DB1 / IBM i STRJRNPF) --

  journal create <name>            create a journal object

  journal attach <jrn> <table>     start journaling a table

  journal detach <jrn> <table>     stop journaling a table

  journal list                     list all journals and attachments

  journal dump <name>              show all entries for a journal

  journal dump <name> <seq>        show entries since sequence number

  journal purge <name>             remove rolled-back entries

  -- Token Auth (Phase G) --

  auth create <email> <uid> <role>  create a bearer token

  auth list                         show token registry

  auth revoke <email>               revoke all tokens for email

  -- Group Profiles (Navigator-Parity Phase 3) --

  group create <name> <role>       new group with an inherited role

  group add <name> <uid>           add uid as a member of a group

  group list                        list all group profiles

  -- Authorization Lists (Navigator-Parity Phase 3) --

  authlist create <name>                    new empty authorization list

  authlist grant obj <list> <obj> <perm>    attach {object,perm} to a list

  authlist grant uid <list> <uid>           add uid as a grantee

  authlist grant group <list> <group>       add group as a grantee

  authlist check <uid> <object> <perm>      test if a list would grant this

  authlist list                              list all authorization lists

  -- Database Namespace & Access (Phase 4) --

  database create <name>                      new database (permission/organizational tag)

  database drop <name>                        drop a database (refuses if a table is still tagged)

  database list                                list all databases

  database grant uid <name> <uid> <perm>      grant a uid access to a database's