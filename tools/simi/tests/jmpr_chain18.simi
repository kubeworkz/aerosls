; jmpr_chain18.simi — M2.42: the flat walk cap MATCHES the BIG cap. M2.41
; raised TX_AR_CHAIN_MAX from 12 to 20; M2.42 raises it to 64, equal to
; TX_AR_CHAIN_BIG, so a 21-64-value product now stays FLAT too — and since
; a set of > 64 values can never chain (the emission gate rejects
; ncand > 64), every reachable chain materializes from a flat set: the
; M2.30-M2.41 record machinery becomes unreachable (vestigial, retained as
; history and as a safety net if the caps ever diverge again).
; Here r1 = r2 + r3 is FORTY values {42..120} (r2 in {2,12,...,72} — EIGHT
; values, r3 in {40,42,44,46,48} — FIVE values); the arm `BC r5, J`
; delivers it into J; then `LOADI r2, #1` WRITES a source. Under the M2.41
; 20-cap the product DEFERRED (R1) and the pc 29 write flattened it to
; UNKNOWN (the eager flatten caps at the walk bound) — the dispatch fell
; to the table. Under the 64-cap the product is flat, the write is a no-op
; for r1's slot, and the gate (324 < 528) emits the 40-pair chain. The
; runtime index 72 + 48 = 120 (r5 == 0 — the arm BC falls through) takes
; the chain's FORTIETH b.eq, landing on block39's LOADI #4000. The
; candidates are real pcs (block0..block39 at 42..120), as the chain
; branches straight to g_instr_off[pc].
; Expected result: 4000
.entry main
main:
    ENTER #8            ; pc 0
    LOADI r0, #0, i64   ; pc 1 — zero: every join BC below falls through
    LOADI r5, #0, i64   ; pc 2 — arm BC NOT taken at runtime (r5 = 0)
    LOADI r2, #2, i64   ; pc 3 — branch-path base (2) — dead at runtime
    BC r0, J2           ; pc 4 — falls through (delivers {r2:2} at J2)
    LOADI r2, #12, i64  ; pc 5
    BC r0, J2           ; pc 6 — falls through (delivers {r2:12} at J2)
    LOADI r2, #22, i64  ; pc 7
    BC r0, J2           ; pc 8 — falls through (delivers {r2:22} at J2)
    LOADI r2, #32, i64  ; pc 9
    BC r0, J2           ; pc 10 — falls through (delivers {r2:32} at J2)
    LOADI r2, #42, i64  ; pc 11
    BC r0, J2           ; pc 12 — falls through (delivers {r2:42} at J2)
    LOADI r2, #52, i64  ; pc 13
    BC r0, J2           ; pc 14 — falls through (delivers {r2:52} at J2)
    LOADI r2, #62, i64  ; pc 15
    BC r0, J2           ; pc 16 — falls through (delivers {r2:62} at J2)
    LOADI r2, #72, i64  ; pc 17 — fall-through base (72)
J2:                     ; (label) — join: r2 in {2,12,22,32,42,52,62,72}
    LOADI r3, #40, i64  ; pc 18
    BC r0, J3           ; pc 19 — falls through (delivers {r3:40} at J3)
    LOADI r3, #42, i64  ; pc 20
    BC r0, J3           ; pc 21 — falls through (delivers {r3:42} at J3)
    LOADI r3, #44, i64  ; pc 22
    BC r0, J3           ; pc 23 — falls through (delivers {r3:44} at J3)
    LOADI r3, #46, i64  ; pc 24
    BC r0, J3           ; pc 25 — falls through (delivers {r3:46} at J3)
    LOADI r3, #48, i64  ; pc 26 — fall-through base (48)
J3:                     ; (label) — join: r3 in {40,42,44,46,48}
    ADD r1, r2, r3, i64 ; pc 27 — r1 = r2 + r3 = 40 values (42..120 evens).
                        ; M2.42: FLAT (fits the 64-cap) — under the M2.41
                        ; 20-cap this DEFERRED (R1) instead.
    BC r5, J            ; pc 28 — NOT taken at runtime (r5 == 0): delivers
                        ; r1's set at J (flat under the 64-cap, R1 under 20)
    LOADI r2, #1, i64   ; pc 29 — WRITE to r2, a SOURCE of r1's product.
                        ; Under the 20-cap this flattens R1 (chain_def_touches
                        ; its DAG) to UNKNOWN — the chain dies, the table
                        ; runs. Under the 64-cap the flat set in r1's slot is
                        ; untouched — the chain survives.
J:                      ; (label) — join: r1 in {42,44,...,120} (40 values)
    JMPR r1             ; pc 30 — candidates {42,44,...,120}, runtime 120
    LOADI r0, #0, i32   ; pc 31 — dead filler (aligns block0 to pc 42)
    LOADI r0, #0, i32   ; pc 32
    LOADI r0, #0, i32   ; pc 33
    LOADI r0, #0, i32   ; pc 34
    LOADI r0, #0, i32   ; pc 35
    LOADI r0, #0, i32   ; pc 36
    LOADI r0, #0, i32   ; pc 37
    LOADI r0, #0, i32   ; pc 38
    LOADI r0, #0, i32   ; pc 39
    LOADI r0, #0, i32   ; pc 40
    LOADI r0, #0, i32   ; pc 41
block0:                 ; pc 42
    LOADI r0, #100, i32 ; pc 42
    RET                 ; pc 43
block1:                 ; pc 44
    LOADI r0, #200, i32 ; pc 44
    RET                 ; pc 45
block2:                 ; pc 46
    LOADI r0, #300, i32 ; pc 46
    RET                 ; pc 47
block3:                 ; pc 48
    LOADI r0, #400, i32 ; pc 48
    RET                 ; pc 49
block4:                 ; pc 50
