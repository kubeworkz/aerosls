; jmpr_chain34.simi — M2.58: the walk's fixpoint convergence, pinned at
; the 64-iteration cap. A BACKWARD-branch join lattice: the loop at
; LOOP (pc 5) increments r2 by r3 = {1} and branches BACK to LOOP,
; delivering r2's set to the already-processed head. The walk is
; path-insensitive, so the head's set grows by ONE value per walk
; iteration ({100}, {100,101}, ...) — an accumulator loop's fixpoint
; is UNBOUNDED, so the walk never converges and the 64-iteration cap
; (iter < 64) stops it at iteration 63. Runtime executes the loop
; 65 times (r5 counts 65 -> 0), so r2 = 100 + 65 = 165 at the JMPR.
; M2.58's probe found the truncation UNSOUND: the pre-fix snapshot at
; iteration 63 is the post-increment {101..164}, the chain fires over
; it, and the runtime index 165 is NOT covered -> the chain falls
; through to UDF (rc=1 on the ARM engine — a legitimate index killed
; by a truncated candidate set). The fix is the exact-or-conservative
; discipline: an UNCONVERGED walk (changed still true after the cap)
; collapses the snapshot to UNKNOWN -> the table, which dispatches
; 165 through its bounds check to block32's LOADI #8000 -> PASS 8000
; on all four engines. Dump-verified: 0 b.eq, the full table
; dispatch. (interp/x86/rv64 execute the .tmo directly — no chain
; analysis — so they pass either way; the pin's discriminator is the
; ARM engine.)
; Expected result: 8000
.entry main
main:
    ENTER #8            ; pc 0
    LOADI r0, #0, i64   ; pc 1 — zero: unused fallback condition
    LOADI r2, #100, i64 ; pc 2 — the index/counter base
    LOADI r3, #1, i64   ; pc 3 — the increment
    LOADI r5, #65, i64  ; pc 4 — runtime loop count (65 iterations)
LOOP:                   ; pc 5 — backward branch target (head)
    ADD r2, r2, r3, i64 ; pc 5 — r2 += 1: the walk's set grows per
                        ; iteration {100}, {100,101}, ... (unbounded)
    SUB r5, r5, #1, i64 ; pc 6 — runtime counter decrement
    BC r5, LOOP         ; pc 7 — taken while r5 != 0 (65 iterations);
                        ; delivers r2's set to LOOP (backward edge)
    JMPR r2             ; pc 8 — runtime 165; pre-fix the truncated
                        ; snapshot {101..164} misses it -> UDF
    LOADI r0, #0, i32   ; pc 9 — dead filler (aligns block0 to pc 101)
    LOADI r0, #0, i32   ; pc 10 — dead filler (aligns block0 to pc 101)
    LOADI r0, #0, i32   ; pc 11 — dead filler (aligns block0 to pc 101)
    LOADI r0, #0, i32   ; pc 12 — dead filler (aligns block0 to pc 101)
