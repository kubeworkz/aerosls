; jmpr_chain32.simi — M2.56: the tracked-register closure at its 8-cap.
; M2.43 raised TX_AR_CHAIN_REGS from 4 to 8 (jmpr_chain19 pinned the
; 5-register closure); this pin regression-guarded that turn-over
; boundary: a closure needing EXACTLY 8 registers — the largest the cap
; admitted then. M2.62 later raised TX_AR_CHAIN_REGS to 12, so the same
; 8-feeder closure now sits BELOW the cap: the fixture still fires its
; 30-pair chain unchanged, and the turn-over boundary itself moved to
; chain38 (12 feeders, M2.62) / chain39 (13 feeders, M2.63). The index
; is built in FOUR stages over joins:
;   r8 in {0, 10}                    (2-way join)
;   r4 = r8 + r8    -> {0, 20}
;   r5 in {0, 10, ..., 50}           (6-way join)
;   r2 = r4 + r5    -> {0..70 step 10}   (8 values)
;   r6 in {80, 90, 100}, r7 in {0, 200, 400}   (3-way joins)
;   r3 = r6 + r7    -> {80,90,100, 280,290,300, 480,490,500}
;   r1 = r2 + r3    -> THIRTY distinct values {80..170} U {280..370} U
;                      {480..570} step 10
; The tracked closure is {r1, r2, r3, r4, r5, r6, r7, r8} — EIGHT
; registers (<= TX_AR_CHAIN_REGS 12): every feeder is tracked and the
; 30-candidate chain fires (the gate: 8*30+4 = 244 < 40 + 4*572 = 2328).
; At the 8-cap era, a closure needing a NINTH register (r4 = r8 + r9
; instead of r8 + r8) would stop growing at 8 — r9 untracked, its set
; UNKNOWN, r1 falls to the table (conservative and correct, dump shows
; 0 b.eq; verified as the ad-hoc control; the analogous 13-feeder
; over-cap is now pinned by chain39, M2.63). The runtime index 10 + 10 + 50 + 100 + 400 = 570
; (all join BCs fall through, r0 == 0) is the LAST of the 30 candidates
; and takes the chain's THIRTIETH b.eq, landing on block29's LOADI
; #3000 — a truncated image (a 29-candidate chain, or one feeder
; dropped) would miss 570 and UDF-trap (rc=1): the discriminator.
; The candidates are real pcs (block0..block29 at 80..570 step 10), as
; the chain branches straight to g_instr_off[pc].
; Expected result: 3000
.entry main
main:
    ENTER #8            ; pc 0
    LOADI r0, #0, i64   ; pc 1 — zero: every join BC below falls through
    LOADI r8, #0, i64   ; pc 2 — r8 branch-path base (0) — dead at runtime
    BC r0, J8           ; pc 3 — falls through (delivers {r8:0} at J8)
    LOADI r8, #10, i64  ; pc 4 — fall-through base (10)
J8:                     ; (label) — join: r8 in {0, 10}
    ADD r4, r8, r8, i64 ; pc 5 — r4 = r8 + r8 = {0, 20} (r8 tracked once)
    LOADI r5, #0, i64   ; pc 6 — r5 branch-path base (0) — dead at runtime
    BC r0, J5           ; pc 7 — falls through (delivers {r5:0} at J5)
    LOADI r5, #10, i64  ; pc 8
    BC r0, J5           ; pc 9 — falls through (delivers {r5:10} at J5)
    LOADI r5, #20, i64  ; pc 10
    BC r0, J5           ; pc 11 — falls through (delivers {r5:20} at J5)
    LOADI r5, #30, i64  ; pc 12
    BC r0, J5           ; pc 13 — falls through (delivers {r5:30} at J5)
    LOADI r5, #40, i64  ; pc 14
    BC r0, J5           ; pc 15 — falls through (delivers {r5:40} at J5)
    LOADI r5, #50, i64  ; pc 16 — fall-through base (50)
J5:                     ; (label) — join: r5 in {0, 10, ..., 50}
    ADD r2, r4, r5, i64 ; pc 17 — r2 = r4 + r5 = {0..70 step 10}
    LOADI r6, #80, i64  ; pc 18 — r6 branch-path base (80) — dead at runtime
    BC r0, J6           ; pc 19 — falls through (delivers {r6:80} at J6)
    LOADI r6, #90, i64  ; pc 20
    BC r0, J6           ; pc 21 — falls through (delivers {r6:90} at J6)
    LOADI r6, #100, i64 ; pc 22 — fall-through base (100)
J6:                     ; (label) — join: r6 in {80, 90, 100}
    LOADI r7, #0, i64   ; pc 23 — r7 branch-path base (0) — dead at runtime
    BC r0, J7           ; pc 24 — falls through (delivers {r7:0} at J7)
    LOADI r7, #200, i64 ; pc 25
    BC r0, J7           ; pc 26 — falls through (delivers {r7:200} at J7)
    LOADI r7, #400, i64 ; pc 27 — fall-through base (400)
J7:                     ; (label) — join: r7 in {0, 200, 400}
    ADD r3, r6, r7, i64 ; pc 28 — r3 = r6 + r7 (9 values)
    ADD r1, r2, r3, i64 ; pc 29 — r1 = r2 + r3 = 30 values {80..570}
                        ; M2.56: the closure {r1..r8} = EIGHT registers,
                        ; exactly TX_AR_CHAIN_REGS — a ninth feeder
                        ; would truncate to the table (conservative).
    JMPR r1             ; pc 30 — candidates {80..170, 280..370, 480..570},
                        ; runtime 10+10+50+100+400 = 570 (the last)
    LOADI r0, #0, i32   ; pc 31 — dead filler (aligns block0 to pc 80)
    LOADI r0, #0, i32   ; pc 32
    LOADI r0, #0, i32   ; pc 33
    LOADI r0, #0, i32   ; pc 34
    LOADI r0, #0, i32   ; pc 35
    LOADI r0, #0, i32   ; pc 36
    LOADI r0, #0, i32   ; pc 37
