; jmpr_unreach.simi — M2.21: the g_alloc gate is scoped to REACHABLE
; JMPRs. `dead` (pc 10) is an unreachable function — entered from
; nowhere, since main's RET at pc 9 is a terminal and nothing targets
; pc 10 — and its JMPR r7 reads an ENTER argument, unknown under the
; constant map, so it NEVER folds. Before M2.21 the gate was "every
; JMPR in the linear stream folds", so this one unreachable JMPR killed
; g_alloc for the WHOLE program: main's own foldable JMPR (r0 = 8 after
; the M2.20 leaf call) was thrown away and everything ran naive. M2.21's
; static reachability pre-pass (a BFS from the entries over the non-JMPR
; edges: BR/BC targets + fall-through, CALL target + fall-through; RET
; and JMPR are terminals) shows pc 11 is never reachable — a JMPR that
; can never dispatch cannot make every pc a potential block head — so
; main's JMPR folds to pc 8 and the cache survives. dead's dynamic
; dispatch path is still emitted (correct code, never executed; it is
; not reached by any runtime path, and the cache discipline is per-path
; so a fold into an unreachable-looking region would land on a rule-1
; block head flush anyway). The reachable non-folding JMPR case is
; untouched: jmpr_oob/jmpr_dyn still gate (their JMPRs are in main).
; Expected result: 9 (pc 8: ADD r0, r0, #1 -> 8 + 1).
.entry main
main:
    ENTER #8            ; pc 0
    LOADI r2, #3, i64   ; pc 1 — arg0 seed
    LOADI r3, #5, i64   ; pc 2 — arg1 seed
    MOV r0, r2, i64     ; pc 3 — arg0 = 3
    MOV r1, r3, i64     ; pc 4 — arg1 = 5
    CALL leaf           ; pc 5 — r0 = 3 + 5 = 8 after the call (M2.20)
    JMPR r0             ; pc 6 — r0 = 8 — folds to pc 8 (a real branch)
    LOADI r9, #99, i64  ; pc 7 — unreachable filler
target:                 ; pc 8 — reached only via the fold
    ADD r0, r0, #1, i64 ; pc 8 — r0 = 8 + 1 = 9
    RET                 ; pc 9 — returns 9
dead:                   ; pc 10 — UNREACHABLE function (M2.21)
    ENTER #8            ; pc 10
    JMPR r7             ; pc 11 — r7 is an ENTER arg — NEVER folds
    RET                 ; pc 12
leaf:                   ; pc 13 — the callee (a straight-line leaf)
    ENTER #8            ; pc 13 — fresh frame: r8+ zeroed, r0-r7 = caller args
    ADD r0, r0, r1, i64 ; pc 14 — r0 = arg0 + arg1
    RET                 ; pc 15
