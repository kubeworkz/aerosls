    LOADI r2, #-113, i64 ; pc 74
    BC r0, J2           ; pc 75 — falls through (delivers {r2:-113} at J2)
    LOADI r2, #-112, i64 ; pc 76
    BC r0, J2           ; pc 77 — falls through (delivers {r2:-112} at J2)
    LOADI r2, #-111, i64 ; pc 78
    BC r0, J2           ; pc 79 — falls through (delivers {r2:-111} at J2)
    LOADI r2, #-110, i64 ; pc 80
    BC r0, J2           ; pc 81 — falls through (delivers {r2:-110} at J2)
    LOADI r2, #-109, i64 ; pc 82
    BC r0, J2           ; pc 83 — falls through (delivers {r2:-109} at J2)
    LOADI r2, #-108, i64 ; pc 84
    BC r0, J2           ; pc 85 — falls through (delivers {r2:-108} at J2)
    LOADI r2, #-107, i64 ; pc 86
    BC r0, J2           ; pc 87 — falls through (delivers {r2:-107} at J2)
    LOADI r2, #-106, i64 ; pc 88
    BC r0, J2           ; pc 89 — falls through (delivers {r2:-106} at J2)
    LOADI r2, #-105, i64 ; pc 90
    BC r0, J2           ; pc 91 — falls through (delivers {r2:-105} at J2)
    LOADI r2, #-104, i64 ; pc 92
    BC r0, J2           ; pc 93 — falls through (delivers {r2:-104} at J2)
    LOADI r2, #-103, i64 ; pc 94
    BC r0, J2           ; pc 95 — falls through (delivers {r2:-103} at J2)
    LOADI r2, #-102, i64 ; pc 96
    BC r0, J2           ; pc 97 — falls through (delivers {r2:-102} at J2)
    LOADI r2, #-101, i64 ; pc 98
    BC r0, J2           ; pc 99 — falls through (delivers {r2:-101} at J2)
    LOADI r2, #-100, i64 ; pc 100
    BC r0, J2           ; pc 101 — falls through (delivers {r2:-100} at J2)
    LOADI r2, #-99, i64  ; pc 102
    BC r0, J2           ; pc 103 — falls through (delivers {r2:-99} at J2)
    LOADI r2, #-98, i64  ; pc 104
    BC r0, J2           ; pc 105 — falls through (delivers {r2:-98} at J2)
    LOADI r2, #-97, i64  ; pc 106
    BC r0, J2           ; pc 107 — falls through (delivers {r2:-97} at J2)
    LOADI r2, #-96, i64  ; pc 108
    BC r0, J2           ; pc 109 — falls through (delivers {r2:-96} at J2)
    LOADI r2, #-95, i64  ; pc 110
    BC r0, J2           ; pc 111 — falls through (delivers {r2:-95} at J2)
    LOADI r2, #-94, i64  ; pc 112
    BC r0, J2           ; pc 113 — falls through (delivers {r2:-94} at J2)
    LOADI r2, #-93, i64  ; pc 114
    BC r0, J2           ; pc 115 — falls through (delivers {r2:-93} at J2)
    LOADI r2, #-92, i64  ; pc 116
    BC r0, J2           ; pc 117 — falls through (delivers {r2:-92} at J2)
    LOADI r2, #-91, i64  ; pc 118
    BC r0, J2           ; pc 119 — falls through (delivers {r2:-91} at J2)
    LOADI r2, #-90, i64  ; pc 120
    BC r0, J2           ; pc 121 — falls through (delivers {r2:-90} at J2)
    LOADI r2, #-89, i64  ; pc 122
    BC r0, J2           ; pc 123 — falls through (delivers {r2:-89} at J2)
    LOADI r2, #-88, i64  ; pc 124
    BC r0, J2           ; pc 125 — falls through (delivers {r2:-88} at J2)
    LOADI r2, #-87, i64  ; pc 126
    BC r0, J2           ; pc 127 — falls through (delivers {r2:-87} at J2)
    LOADI r2, #-86, i64  ; pc 128
    BC r0, J2           ; pc 129 — falls through (delivers {r2:-86} at J2)
    LOADI r2, #-150, i64 ; pc 130 — fall-through base (-150) — the runtime
                        ; value: every BC falls through, so r2 is -150 at J2.
J2:                     ; (label) — join: r2 in {-150,-149,...,-86} (65
                        ; DISTINCT values)
    NEG r1, r2, i64     ; pc 131 — the index build: r1 = -r2 = 65 distinct
                        ; values {86..150} — OVERFLOWS the image merge cap
                        ; (64) -> chain_img_alu returns UNKNOWN -> the
                        ; chain dies conservatively.
    JMPR r1             ; pc 132 — runtime -(-150) = 150.
    LOADI r0, #0, i32   ; pc 133 — dead filler (aligns block0 to pc 150)
    LOADI r0, #0, i32   ; pc 134
    LOADI r0, #0, i32   ; pc 135
    LOADI r0, #0, i32   ; pc 136
    LOADI r0, #0, i32   ; pc 137
    LOADI r0, #0, i32   ; pc 138
    LOADI r0, #0, i32   ; pc 139
    LOADI r0, #0, i32   ; pc 140
    LOADI r0, #0, i32   ; pc 141
    LOADI r0, #0, i32   ; pc 142
    LOADI r0, #0, i32   ; pc 143
    LOADI r0, #0, i32   ; pc 144
    LOADI r0, #0, i32   ; pc 145
    LOADI r0, #0, i32   ; pc 146
    LOADI r0, #0, i32   ; pc 147
    LOADI r0, #0, i32   ; pc 148
    LOADI r0, #0, i32   ; pc 149
block0:                 ; pc 150
    LOADI r0, #777, i32 ; pc 150
    RET                 ; pc 151
