; jmpr_chain27.simi — M2.51: the UNARY cap discipline, promoted from
; M2.50's ad-hoc teeth into a committed pin. M2.48's chain24 pinned the
; EXACT side (a ten-value NEG source maps to ten candidates and
; chains); this pin originally regression-guarded the COLLAPSE: at the
; M2.51-era caps (64, TX_AR_CHAIN_MAX / TX_AR_CHAIN_BIG) the
; SIXTY-FIVE-DISTINCT join source through NEG (65 values {86..150})
; OVERFLOWED the image merge cap inside chain_img_alu -> UNKNOWN ->
; the table. M2.61's EQUAL-CAPS bump (MAX = BIG = 96) changed this
; pin's meaning, exactly like chain33's: 65 <= 96 now FITS, so the
; image materializes and the chain FIRES with the full 65 candidates.
; The index is r1 = -r2 over a 65-way join (r2 in {-150,-149,...,-86}
; -> 65 values {86..150}); runtime -(-150) = 150 takes the chain's
; SIXTY-FIFTH b.eq -> block0 at pc 150 -> LOADI #777 -> PASS 777 on
; all four engines. The test DISCRIMINATES truncation: a wrong
; analysis that emitted a chain over only the first 64 candidates
; {86..149} would miss runtime 150, miss every b.eq and UDF-trap
; (rc=1) — only the exact-or-conservative emission passes. The
; collapse side of the discipline moved to chain30 (100 values > 96).
; Dump-verified (96/96): 65 b.eq, 0 table words.
; Expected result: 777
.entry main
main:
    ENTER #8            ; pc 0
    LOADI r0, #0, i64   ; pc 1 — zero: every join BC below falls through
    LOADI r2, #-149, i64 ; pc 2 — branch-path base (-149) — dead at runtime
    BC r0, J2           ; pc 3 — falls through (delivers {r2:-149} at J2)
    LOADI r2, #-148, i64 ; pc 4
    BC r0, J2           ; pc 5 — falls through (delivers {r2:-148} at J2)
    LOADI r2, #-147, i64 ; pc 6
    BC r0, J2           ; pc 7 — falls through (delivers {r2:-147} at J2)
    LOADI r2, #-146, i64 ; pc 8
    BC r0, J2           ; pc 9 — falls through (delivers {r2:-146} at J2)
    LOADI r2, #-145, i64 ; pc 10
    BC r0, J2           ; pc 11 — falls through (delivers {r2:-145} at J2)
    LOADI r2, #-144, i64 ; pc 12
    BC r0, J2           ; pc 13 — falls through (delivers {r2:-144} at J2)
    LOADI r2, #-143, i64 ; pc 14
    BC r0, J2           ; pc 15 — falls through (delivers {r2:-143} at J2)
    LOADI r2, #-142, i64 ; pc 16
    BC r0, J2           ; pc 17 — falls through (delivers {r2:-142} at J2)
    LOADI r2, #-141, i64 ; pc 18
    BC r0, J2           ; pc 19 — falls through (delivers {r2:-141} at J2)
    LOADI r2, #-140, i64 ; pc 20
    BC r0, J2           ; pc 21 — falls through (delivers {r2:-140} at J2)
    LOADI r2, #-139, i64 ; pc 22
    BC r0, J2           ; pc 23 — falls through (delivers {r2:-139} at J2)
    LOADI r2, #-138, i64 ; pc 24
    BC r0, J2           ; pc 25 — falls through (delivers {r2:-138} at J2)
    LOADI r2, #-137, i64 ; pc 26
    BC r0, J2           ; pc 27 — falls through (delivers {r2:-137} at J2)
    LOADI r2, #-136, i64 ; pc 28
    BC r0, J2           ; pc 29 — falls through (delivers {r2:-136} at J2)
    LOADI r2, #-135, i64 ; pc 30
    BC r0, J2           ; pc 31 — falls through (delivers {r2:-135} at J2)
    LOADI r2, #-134, i64 ; pc 32
    BC r0, J2           ; pc 33 — falls through (delivers {r2:-134} at J2)
    LOADI r2, #-133, i64 ; pc 34
    BC r0, J2           ; pc 35 — falls through (delivers {r2:-133} at J2)
    LOADI r2, #-132, i64 ; pc 36
    BC r0, J2           ; pc 37 — falls through (delivers {r2:-132} at J2)
    LOADI r2, #-131, i64 ; pc 38
    BC r0, J2           ; pc 39 — falls through (delivers {r2:-131} at J2)
    LOADI r2, #-130, i64 ; pc 40
    BC r0, J2           ; pc 41 — falls through (delivers {r2:-130} at J2)
    LOADI r2, #-129, i64 ; pc 42
    BC r0, J2           ; pc 43 — falls through (delivers {r2:-129} at J2)
    LOADI r2, #-128, i64 ; pc 44
    BC r0, J2           ; pc 45 — falls through (delivers {r2:-128} at J2)
    LOADI r2, #-127, i64 ; pc 46
    BC r0, J2           ; pc 47 — falls through (delivers {r2:-127} at J2)
    LOADI r2, #-126, i64 ; pc 48
    BC r0, J2           ; pc 49 — falls through (delivers {r2:-126} at J2)
    LOADI r2, #-125, i64 ; pc 50
    BC r0, J2           ; pc 51 — falls through (delivers {r2:-125} at J2)
    LOADI r2, #-124, i64 ; pc 52
    BC r0, J2           ; pc 53 — falls through (delivers {r2:-124} at J2)
    LOADI r2, #-123, i64 ; pc 54
    BC r0, J2           ; pc 55 — falls through (delivers {r2:-123} at J2)
    LOADI r2, #-122, i64 ; pc 56
    BC r0, J2           ; pc 57 — falls through (delivers {r2:-122} at J2)
    LOADI r2, #-121, i64 ; pc 58
    BC r0, J2           ; pc 59 — falls through (delivers {r2:-121} at J2)
    LOADI r2, #-120, i64 ; pc 60
    BC r0, J2           ; pc 61 — falls through (delivers {r2:-120} at J2)
    LOADI r2, #-119, i64 ; pc 62
    BC r0, J2           ; pc 63 — falls through (delivers {r2:-119} at J2)
    LOADI r2, #-118, i64 ; pc 64
    BC r0, J2           ; pc 65 — falls through (delivers {r2:-118} at J2)
    LOADI r2, #-117, i64 ; pc 66
    BC r0, J2           ; pc 67 — falls through (delivers {r2:-117} at J2)
    LOADI r2, #-116, i64 ; pc 68
