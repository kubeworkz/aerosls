; epi_merge4.simi — M2.17: the epi-merge dead region with a COMPUTED
; fold index. Same single-edge backward fold shape as epi_merge
; (pattern@T, RET@T+1, two intermediates@T+2/T+3, matching tail@T+4,
; fold@T+5), but the second intermediate is an ARITHMETIC chain instead
; of a second LOADI: LOADI r4, #1 (pc 6, the seed) then ADD r5, r4, #3
; (pc 7) computes the fold index r5 = 1 + 3 = 4 — the M2.1 constant
; analysis folds it (r5's chain is entirely inside the dead region,
; after the BR-target reset at pc 6), so the JMPR at pc 9 folds BACKWARD
; to T = 4. The M2.15 pass required both intermediates to be
; LOADI/LOADI64; M2.17 widens them to any plain result-op
; (ar_is_interm_op) because the merge invariants depend only on the
; claim count (two fresh claims net +3 ≡ 0 mod 3, so the tail's result
; host stays cnt%3 = 2 = x11) and the destinations being distinct and
; not the pattern's sources — NOT on what computes the values. Here the
; tail's r2/r1 fetches EVICT the intermediate results r4 (x9) and r5
; (x10) — standard clobber, slots kept current — then establish the r2
; and r1 transients, both of which survive the fold's flush (x11 holds
; the result, stored; x9/x10 untouched): flags = 3, both head fetches
; drop, r0 = r2 + r1 = 7. Reverting the widening (T+3 must be a LOADI)
; rejects the shape: the merge does not fire, the head reloads both
; sources (+8 bytes), still correct — the size gate teeth.
; Expected result: 7 (r0 = r2 + r1 = 3 + 4)
.entry main
main:
    ENTER #8
    LOADI r2, #3, i64        ; pc 1 — the pattern's first source (r2 = 3)
    LOADI r1, #4, i64        ; pc 2 — the pattern's second source (r1 = 4)
    BR src                   ; pc 3 — T-1: terminal, jumps INTO the fold source
target:                      ; pc 4 = T — reached only via the fold at pc 9
    ADD r0, r2, r1, i64      ; pc 4 — the pattern: reads r2, r1 — r0 = 7
    RET                      ; pc 5 — returns r0 = 3 + 4 = 7
src:                         ; pc 6 — the fold source (the BR target)
    LOADI r4, #1, i64        ; pc 6 — T+2: the seed (fresh claim, sets r4 = 1)
    ADD r5, r4, #3, i64      ; pc 7 — T+3: COMPUTED — r5 = 1 + 3 = 4 (the fold index)
    ADD r9, r2, r1, i64      ; pc 8 — the tail: reads r2, r1 (same pattern)
    JMPR r5                  ; pc 9 — r5 = 4 — folds to pc 4 — the single incoming edge
