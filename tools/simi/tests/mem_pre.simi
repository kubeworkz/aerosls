; mem_pre.simi — M2.10: the unscaled ldur/stur load/store fold. ANY
; displacement that fits A64's signed 9-bit imm9 ([-256, 255]) now folds
; into a single ldr/str xt, [xb, #imm] word, with NO writeback and NO
; alignment requirement — this supersedes the M2.9 pre-indexed fold
; (which needed alignment to the access width) and folds the unaligned
; displacements M2.8's address math had to sub/add + access in two words.
; The rows:
;   [r5-16]    i64 unscaled             -> r7+2032
;   [r5-256]   i64 unscaled             -> r7+1792  (exact imm9 boundary,
;              -256 is the most negative 9-bit signed value)
;   [r5-264]   i64 NO fold              -> r7+1784  (264 > 255 — falls to
;              the M2.8 sub #264 + access)
;   [r5-8]     i32 unscaled             -> r7+2040
;   [r5-4]     i32 unscaled             -> r7+2044
;   [r5+5]     i32 unscaled POSITIVE     -> r7+2053  (+5 is UNALIGNED for
;              i32, so the scaled fast path rejects it and M2.8 folded it
;              as add #5 + access; the unscaled form folds it in one word)
;   [r5-45]    i32 unscaled NEGATIVE     -> r7+2003  (-45 unaligned: M2.9's
;              pre-indexed form also rejected it — this row is the reason
;              M2.10 replaces it)
;   [r6-6]     i16 unscaled (sturh/ldurh)-> r7+3042
;   [r6-1]     u8  unscaled (sturb/ldurb)-> r7+3047
;   [r6-9]     i8  unscaled (ldursb)     -> r7+3039  (the sign-extending
;              byte load is the one opc/size combo the u8 row doesn't cover)
;   [r6-24]    i64 unscaled              -> r7+3024
;   [r6-258]   i16 NO fold               -> r7+2790  (258 > 255)
; Every unscaled store round-trips through a load at the same address,
; and every row RE-READS its base register (r5/r6) — the unscaled form
; has NO writeback, so the base's cache directory entry stays VALID and
; the register is reused by the next fetch (the M2.9 pre-indexed form
; needed clobber_scratch to poison the slot; this form is simpler).
; Effective offsets stay in r7+[560, 4092] — the band portable across all
; four engines (x86's r7 is a host pointer into a 4096-byte mmap,
; ARM/RV64's r7 is scratch_ptr with the 576-byte frame below 560, the
; interpreter's r7 is 0 with 64 KiB), and every access is >= 4 bytes from
; its neighbors (the i32-overlap trap mem_neg.simi's comments record).
; Bases built with folding LEA/ADD: r5 = r7 + 2048, r6 = r7 + 3048.
; r1 = 100, r2 = 200
; [r5-16]=100, [r5-256]=200, [r5-264]=100, [r5-8]=200, [r5-4]=200,
; [r5+5]=100, [r5-45]=200,
; [r6-6]=100, [r6-1]=200, [r6-9]=100, [r6-24]=100, [r6-258]=200
; r3=100, r4=200, r8=100, r9=200, r10=200, r16=100, r17=200, r11=100,
; r12=200, r15=100, r13=100, r14=200
; r0 = 100+200+100+200+200+100+200+100+200+100+200+100 = 1800
; Expected result: 1800
.entry main
main:
    ENTER #12
    LOADI r1, #100, i32
    LOADI r2, #200, i32
    LEA r5, r7, #2048          ; r5 = r7 + 2048 (fold: add #2048)
    LEA r6, r7, #2048          ; r6 = r7 + 2048
    ADD r6, r6, #1000, i32     ; r6 = r7 + 3048 (fold: add #1000)
    STORE r1, r5, #-16, i64
    STORE r2, r5, #-256, i64
    STORE r1, r5, #-264, i64
    STORE r2, r5, #-8, i32
    STORE r2, r5, #-4, i32
    STORE r1, r5, #5, i32
    STORE r2, r5, #-45, i32
    STORE r1, r6, #-6, i16
    STORE r2, r6, #-1, u8
    STORE r1, r6, #-9, i8
    STORE r1, r6, #-24, i64
    STORE r2, r6, #-258, i16
    LOAD r3, r5, #-16, i64
    LOAD r4, r5, #-256, i64
    LOAD r8, r5, #-264, i64
    LOAD r9, r5, #-8, i32
    LOAD r10, r5, #-4, i32
    LOAD r16, r5, #5, i32
    LOAD r17, r5, #-45, i32
    LOAD r11, r6, #-6, i16
    LOAD r12, r6, #-1, u8
    LOAD r15, r6, #-9, i8
    LOAD r13, r6, #-24, i64
    LOAD r14, r6, #-258, i16
    ADD r0, r3, r4, i32
    ADD r0, r0, r8, i32
    ADD r0, r0, r9, i32
    ADD r0, r0, r10, i32
    ADD r0, r0, r16, i32
    ADD r0, r0, r17, i32
    ADD r0, r0, r11, i32
    ADD r0, r0, r12, i32
    ADD r0, r0, r15, i32
    ADD r0, r0, r13, i32
    ADD r0, r0, r14, i32
    RET
