; mem_reg.simi — M2.11: the register-offset load/store fold and its
; run-reuse. A displacement past the imm12 range (|disp| > 4095 and not a
; multiple of 4096 — the "materialize path") now goes into a register and
; the access itself is a single ldr/str xt, [xb, xm] word (the M2.8
; li64 + add_shift + zero-offset access was two words of address math on
; top of the materialize). Consecutive LOAD/STORE that share the SAME
; materialize-class displacement form a RUN: the displacement is
; materialized ONCE into x12 (X_DR, outside the x9/x10/x11 cache) at the
; run head and every access in the run is then just the one register-
; offset word. The rows:
;   [r4-100]    imm9 control     -> r7+900   (folds to stur/ldur #-100,
;               one word each — runs are only formed for materialize-class
;               displacements, so this pair is left alone)
;   [r5-4096]   imm12 control    -> r7+1904  (sub #1, lsl #12 + access —
;               also excluded from runs; unchanged from M2.8)
;   [r5-5250]   standalone pair  -> r7+750   (materialize-class but NOT a
;               run: an ADD into r15 (a free register — NOT r0, which feeds
;               the final sum) sits between the store and the load, so each
;               pays its own per-instruction register-offset fold)
;   [r5-5000]   RUN of 5 (i64)   -> r7+1000  (STORE,STORE,LOAD,STORE,LOAD
;               — one li64 into x12, then five ldr/str x, [x9, x12])
;   [r6-7000]   RUN of 3 (i64)   -> r7+800
;   [r6-7100]   RUN of 2 (i32)   -> r7+700   (the narrow forms must use
;               SXTW — LSL #0 would zero-extend Wm and turn -7100 into a
;               huge positive offset; the SXTW row pins that)
; Every access round-trips store->load at the same address. Effective
; offsets stay in r7+[560, 4092] — the portable band (x86's r7 is a host
; pointer into a 4096-byte mmap, ARM/RV64's r7 is scratch_ptr with the
; 576-byte frame below 560) — and every access is >= 4 bytes from its
; neighbors (the i32-overlap trap mem_neg.simi's comments record). Bases
; built with folding LEA/ADD: r4 = r7 + 1000, r5 = r7 + 6000, r6 =
; r7 + 7800.
; r1 = 100, r2 = 200
; [r4-100]=100 (r11), [r5-4096]=200 (r12), [r5-5250]=100 (r10)
; run1 [r5-5000]: r3=200, r14=100 ; run2 [r6-7000]: r8=200, r9=200
; run3 [r6-7100]: r13=200
; r0 = 100+200+100+200+100+200+200+200 = 1300
; Expected result: 1300
.entry main
main:
    ENTER #12
    LOADI r1, #100, i32
    LOADI r2, #200, i32
    LEA r4, r7, #1000          ; r4 = r7 + 1000 (fold: add #1000)
    LEA r5, r7, #4095          ; r5 = r7 + 4095
    ADD r5, r5, #1905, i32     ; r5 = r7 + 6000 (fold: add #1905)
    LEA r6, r7, #4095          ; r6 = r7 + 4095
    ADD r6, r6, #3705, i32     ; r6 = r7 + 7800 (fold: add #3705)
    STORE r1, r4, #-100, i64
    LOAD  r11, r4, #-100, i64
    STORE r2, r5, #-4096, i64
    LOAD  r12, r5, #-4096, i64
    STORE r1, r5, #-5250, i64
    ADD r15, r0, r1, i32       ; run breaker (writes a free reg, not r0) — the pair above is NOT a run
    LOAD  r10, r5, #-5250, i64
    STORE r1, r5, #-5000, i64
    STORE r2, r5, #-5000, i64
    LOAD  r3, r5, #-5000, i64
    STORE r1, r5, #-5000, i64
    LOAD  r14, r5, #-5000, i64
    STORE r2, r6, #-7000, i64
    LOAD  r8, r6, #-7000, i64
    LOAD  r9, r6, #-7000, i64
    STORE r2, r6, #-7100, i32
    LOAD  r13, r6, #-7100, i32
    ADD r0, r0, r11, i32
    ADD r0, r0, r12, i32
    ADD r0, r0, r10, i32
    ADD r0, r0, r3, i32
    ADD r0, r0, r14, i32
    ADD r0, r0, r8, i32
    ADD r0, r0, r9, i32
    ADD r0, r0, r13, i32
    RET
