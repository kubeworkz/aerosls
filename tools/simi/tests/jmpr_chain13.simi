    LOADI r0, #1700, i32 ; pc 58
    RET                 ; pc 59
block17:                ; pc 60
    LOADI r0, #1800, i32 ; pc 60
    RET                 ; pc 61
block18:                ; pc 62
    LOADI r0, #1900, i32 ; pc 62
    RET                 ; pc 63
block19:                ; pc 64
    LOADI r0, #2000, i32 ; pc 64
    RET                 ; pc 65
block20:                ; pc 66
    LOADI r0, #2100, i32 ; pc 66
    RET                 ; pc 67
block21:                ; pc 68
    LOADI r0, #2200, i32 ; pc 68
    RET                 ; pc 69
block22:                ; pc 70
    LOADI r0, #2300, i32 ; pc 70
    RET                 ; pc 71
block23:                ; pc 72
    LOADI r0, #2400, i32 ; pc 72
    RET                 ; pc 73
block24:                ; pc 74
    LOADI r0, #2500, i32 ; pc 74
    RET                 ; pc 75
block25:                ; pc 76
    LOADI r0, #2600, i32 ; pc 76
    RET                 ; pc 77
block26:                ; pc 78
    LOADI r0, #2700, i32 ; pc 78
    RET                 ; pc 79
block27:                ; pc 80
    LOADI r0, #2800, i32 ; pc 80
    RET                 ; pc 81
block28:                ; pc 82
    LOADI r0, #2900, i32 ; pc 82
    RET                 ; pc 83
block29:                ; pc 84
    LOADI r0, #3000, i32 ; pc 84
    RET                 ; pc 85
block30:                ; pc 86
    LOADI r0, #3100, i32 ; pc 86
    RET                 ; pc 87
    LOADI r0, #0, i32   ; pc 88 — dead filler (aligns block31 to pc 102)
    LOADI r0, #0, i32   ; pc 89
    LOADI r0, #0, i32   ; pc 90
    LOADI r0, #0, i32   ; pc 91
    LOADI r0, #0, i32   ; pc 92
    LOADI r0, #0, i32   ; pc 93
    LOADI r0, #0, i32   ; pc 94
    LOADI r0, #0, i32   ; pc 95
    LOADI r0, #0, i32   ; pc 96
    LOADI r0, #0, i32   ; pc 97
    LOADI r0, #0, i32   ; pc 98
    LOADI r0, #0, i32   ; pc 99
    LOADI r0, #0, i32   ; pc 100
    LOADI r0, #0, i32   ; pc 101
block31:                ; pc 102
    LOADI r0, #3200, i32 ; pc 102
    RET                 ; pc 103
