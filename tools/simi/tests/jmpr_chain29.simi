; jmpr_chain29.simi — M2.53: the unary-over-deferred boundary, probed
; from the flat side. The brief asks whether the unary branch's
; "deferred source -> UNKNOWN" fallback is reachable. The static trace
; shows it IS reachable in principle: the M2.30 root allocates a record
; whenever a register-form product overflows the merge cap with known
; FLAT sources (a >96-distinct image — the M2.42 "UNREACHABLE" comment
; means such records can never lead to a CHAIN, not that they are never
; allocated), so a >96 product followed by a NOT/NEG hits the fallback.
; The fallback is provably conservative: the record-collapse and the
; plain-UNKNOWN-collapse are observationally identical (both -> the
; table), and the true set (>96) can never chain anyway. This pin
; proves the FLAT side of the boundary: a product whose image EXCEEDED
; the OLD flat cap (12, pre-M2.41) but fits the current 96 — 19
; distinct values — does NOT create a record, so the following unary
; RE-DERIVES from the flat image and the chain fires.
; The index: r1 = -(r2 + r3) with r2, r3 in {-79,-77,...,-61} (ten odd
; negatives each). The ADD product is the 19 even values
; {-158,-156,...,-122} (odd+odd, 19 distinct <= 96 — flat, no record; a
; 12-cap walker would defer it — the teeth prove that shape collapses
; conservatively at the NEG). The in-place NEG re-derives to
; {122,124,...,158}. Runtime -( -61 + -61 ) = 122 -> the chain's FIRST
; b.eq -> block0 -> LOADI #100. Candidates are real pcs (blocks at
; 122..158 step 2). The gate (156 < 40 + 4*160 = 680) emits the
; 19-pair chain.
; Expected result: 100
.entry main
main:
    ENTER #8            ; pc 0
    LOADI r0, #0, i64   ; pc 1 — zero: every join BC below falls through
    LOADI r2, #-79, i64 ; pc 2 — branch-path base (-79) — dead at runtime
    BC r0, Ja           ; pc 3 — falls through (delivers {r2:-79} at Ja)
    LOADI r2, #-77, i64 ; pc 4
    BC r0, Ja           ; pc 5 — falls through (delivers {r2:-77} at Ja)
    LOADI r2, #-75, i64 ; pc 6
    BC r0, Ja           ; pc 7 — falls through (delivers {r2:-75} at Ja)
    LOADI r2, #-73, i64 ; pc 8
    BC r0, Ja           ; pc 9 — falls through (delivers {r2:-73} at Ja)
    LOADI r2, #-71, i64 ; pc 10
    BC r0, Ja           ; pc 11 — falls through (delivers {r2:-71} at Ja)
    LOADI r2, #-69, i64 ; pc 12
    BC r0, Ja           ; pc 13 — falls through (delivers {r2:-69} at Ja)
    LOADI r2, #-67, i64 ; pc 14
    BC r0, Ja           ; pc 15 — falls through (delivers {r2:-67} at Ja)
    LOADI r2, #-65, i64 ; pc 16
    BC r0, Ja           ; pc 17 — falls through (delivers {r2:-65} at Ja)
    LOADI r2, #-63, i64 ; pc 18
    BC r0, Ja           ; pc 19 — falls through (delivers {r2:-63} at Ja)
    LOADI r2, #-61, i64 ; pc 20 — fall-through base (-61)
Ja:                     ; (label) — join: r2 in {-79,...,-61} (10 values)
    LOADI r3, #-79, i64 ; pc 21 — branch-path base (-79) — dead at runtime
    BC r0, Jb           ; pc 22 — falls through (delivers {r3:-79} at Jb)
    LOADI r3, #-77, i64 ; pc 23
    BC r0, Jb           ; pc 24 — falls through (delivers {r3:-77} at Jb)
    LOADI r3, #-75, i64 ; pc 25
    BC r0, Jb           ; pc 26 — falls through (delivers {r3:-75} at Jb)
    LOADI r3, #-73, i64 ; pc 27
    BC r0, Jb           ; pc 28 — falls through (delivers {r3:-73} at Jb)
    LOADI r3, #-71, i64 ; pc 29
    BC r0, Jb           ; pc 30 — falls through (delivers {r3:-71} at Jb)
    LOADI r3, #-69, i64 ; pc 31
    BC r0, Jb           ; pc 32 — falls through (delivers {r3:-69} at Jb)
    LOADI r3, #-67, i64 ; pc 33
    BC r0, Jb           ; pc 34 — falls through (delivers {r3:-67} at Jb)
    LOADI r3, #-65, i64 ; pc 35
    BC r0, Jb           ; pc 36 — falls through (delivers {r3:-65} at Jb)
    LOADI r3, #-63, i64 ; pc 37
    BC r0, Jb           ; pc 38 — falls through (delivers {r3:-63} at Jb)
    LOADI r3, #-61, i64 ; pc 39 — fall-through base (-61)
Jb:                     ; (label) — join: r3 in {-79,...,-61} (10 values)
    ADD r1, r2, r3, i64 ; pc 40 — the product: 100 pairs -> the 19 even
                        ; values {-158..-122 step 2} — 19 distinct, <= 64:
                        ; FLAT (a 12-cap walker would defer it; the
                        ; 64-cap walker keeps it flat, so no record).
    NEG r1, r1, i64     ; pc 41 — the unary over the FLAT image:
                        ; re-derives to {122..158 step 2} — the unary-
                        ; over-deferred fallback is NOT reached (no
                        ; record exists for a sub-64 product).
    JMPR r1             ; pc 42 — candidates {122..158 step 2}, runtime
                        ; -( -61 + -61 ) = 122.
    LOADI r0, #0, i32   ; pc 43 — dead filler (aligns block0 to pc 122)
    LOADI r0, #0, i32   ; pc 44
    LOADI r0, #0, i32   ; pc 45
    LOADI r0, #0, i32   ; pc 46
    LOADI r0, #0, i32   ; pc 47
    LOADI r0, #0, i32   ; pc 48
    LOADI r0, #0, i32   ; pc 49
    LOADI r0, #0, i32   ; pc 50
    LOADI r0, #0, i32   ; pc 51
    LOADI r0, #0, i32   ; pc 52
    LOADI r0, #0, i32   ; pc 53
    LOADI r0, #0, i32   ; pc 54
    LOADI r0, #0, i32   ; pc 55
    LOADI r0, #0, i32   ; pc 56
    LOADI r0, #0, i32   ; pc 57
    LOADI r0, #0, i32   ; pc 58
    LOADI r0, #0, i32   ; pc 59
    LOADI r0, #0, i32   ; pc 60
    LOADI r0, #0, i32   ; pc 61
    LOADI r0, #0, i32   ; pc 62
