; jmpr_chain39.simi — M2.63: the tracked-register closure ONE PAST
; its 12-cap. M2.62 pinned the AT-cap turn-over (jmpr_chain38 — the
; closure {r1..r12} = exactly TX_AR_CHAIN_REGS); this pin regression-
; guards the OVER-cap side: a closure needing EXACTLY THIRTEEN
; registers — the smallest the cap rejects — must truncate
; conservatively to the table (0 b.eq, bounds-checked dispatch).
; The index is chain38's six stages plus an intermediate:
;   r8 in {0, 10}                    (2-way join)
;   r4 = r8 + r8    -> {0, 20}       (self-add: r8 tracked ONCE)
;   r9 in {0, 10}, r10 in {0, 5}     (2-way joins)
;   r5 = r9 + r10   -> {0,5,10,15}
;   r2 = r4 + r5    -> {0..35 step 5}   (8 values)
;   r11 in {40, 50}, r12 in {0, 5}   (2-way joins)
;   r6 = r11 + r12  -> {40,45,50,55}
;   r7 in {0, 200}                   (2-way join — narrowed from
;     chain38's 3-way so the COMPLETED image fits the 96-cap)
;   r3 = r6 + r7    -> 8 values {40..55} U {240..255} step 5
;   r13 = r2 + r6   -> {40..90 step 5}  (11 values)
;   r1 = r13 + r3   -> 28 values {80..145} U {280..345} step 5
; The closure {r1,r13,r3,r2,r6,r7,r4,r5,r11,r12,r8,r9} = TWELVE
; registers: the scan fills in stream order and the ntr < cap guard
; blocks the THIRTEENTH (r10 — the LAST feeder added in round 4),
; so r5 = r9 + r10 has an UNKNOWN source, poisoning r2 -> r13 -> r1
; to UNKNOWN: no chain, the runtime table, 0 b.eq (dump-verified).
; The turn-over control (REGS=13, ad hoc): r10 tracked, the image
; completes at 28 values <= TX_AR_CHAIN_MAX=96, and the 28-candidate
; chain fires — the same fixture, the chain shape (28 b.eq);
; reverting restores the shipped table. The runtime index 345 = the
; LAST of the control chain's candidates, so both shapes land on
; block33 at pc 345 (LOADI #3200): the discriminator is the dump
; shape + byte size, not the result.
; Expected result: 3200
.entry main
main:
    ENTER #8            ; pc 0
    LOADI r0, #0, i64   ; pc 1 — zero: every join BC below falls through
    LOADI r8, #0, i64 ; pc 2
    BC r0, J8           ; pc 3 — falls through (delivers {r8:0} at J8)
    LOADI r8, #10, i64 ; pc 4 — fall-through base (10)
J8:                     ; (label) — join: r8 in {0, 10}
    ADD r4, r8, r8, i64 ; pc 5 — r4 = r8 + r8 = {0, 20} (r8 tracked once)
    LOADI r9, #0, i64 ; pc 6
    BC r0, J9           ; pc 7 — falls through (delivers {r9:0} at J9)
    LOADI r9, #10, i64 ; pc 8 — fall-through base (10)
J9:                     ; (label) — join: r9 in {0, 10}
    LOADI r10, #0, i64 ; pc 9
    BC r0, J10           ; pc 10 — falls through (delivers {r10:0} at J10)
    LOADI r10, #5, i64 ; pc 11 — fall-through base (5)
J10:                     ; (label) — join: r10 in {0, 5}
    ADD r5, r9, r10, i64 ; pc 12 — r5 = r9 + r10 = {0,5,10,15}
    ADD r2, r4, r5, i64 ; pc 13 — r2 = r4 + r5 = {0..35 step 5}
    LOADI r11, #40, i64 ; pc 14
    BC r0, J11           ; pc 15 — falls through (delivers {r11:40} at J11)
    LOADI r11, #50, i64 ; pc 16 — fall-through base (50)
J11:                     ; (label) — join: r11 in {40, 50}
    LOADI r12, #0, i64 ; pc 17
    BC r0, J12           ; pc 18 — falls through (delivers {r12:0} at J12)
    LOADI r12, #5, i64 ; pc 19 — fall-through base (5)
J12:                     ; (label) — join: r12 in {0, 5}
    ADD r6, r11, r12, i64 ; pc 20 — r6 = r11 + r12 = {40,45,50,55}
    LOADI r7, #0, i64 ; pc 21
    BC r0, J7           ; pc 22 — falls through (delivers {r7:0} at J7)
    LOADI r7, #200, i64 ; pc 23 — fall-through base (200)
J7:                     ; (label) — join: r7 in {0, 200}
    ADD r3, r6, r7, i64 ; pc 24 — r3 = r6 + r7 = 8 values
    ADD r13, r2, r6, i64 ; pc 25 — r13 = r2 + r6 = 11 values {40..90}
                        ; M2.63: the closure {r1..r9, r11, r12, r13}
                        ; = TWELVE registers = TX_AR_CHAIN_REGS; the
                        ; THIRTEENTH (r10) is untracked -> r1 UNKNOWN
                        ; -> the runtime table (conservative, 0 b.eq).
    ADD r1, r13, r3, i64 ; pc 26 — r1 = r13 + r3 (28 values)
    JMPR r1             ; pc 27 — table dispatch; runtime 90 + 255 = 345
    LOADI r0, #0, i32   ; pc 28 — dead filler
    LOADI r0, #0, i32   ; pc 29 — dead filler
    LOADI r0, #0, i32   ; pc 30 — dead filler
