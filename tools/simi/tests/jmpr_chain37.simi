; jmpr_chain37.simi — M2.61: the EQUAL-CAPS turn-over pin at the NEW
; caps. M2.61 permanently bumps TX_AR_CHAIN_MAX and TX_AR_CHAIN_BIG
; together 64 -> 96 (the equal-caps regression: the discipline the
; M2.54/M2.55 divergences threatened must hold at ANY equal value,
; and nothing may hardcode 64). This pin regression-guards the new
; turn-over boundary: the largest set the machinery can represent
; (n == MAX == BIG, exactly 96 values), materializing through the
; flat walk, the head union, and the emission gate all at the same
; point. A truncated materialization (a union one short, or a store
; one short) would miss the runtime index and UDF-trap — the
; discriminator. The index: the union of two flat products, mirroring
; chain31's R-arm shape. R1 = r2 + r3 (r2 in {52,68,84,100,116,132},
; r3 in {0,2,...,14} -> FORTY-EIGHT values {52..146} step 2) and
; R2 = r2 + r6 (r6 in {200,202,...,214} -> FORTY-EIGHT values
; {252..346} step 2); the union {52..146} U {252..346} = 96 DISTINCT
; values — exactly the new MAX = BIG. The R-arm's `BC r5, J` (r5 = 0,
; not taken) delivers R1 into J; the fall-through computes R2 and
; flows in as the carry, so J's union is the full 96. The gate
; (8*96+4 = 772 < 40 + 4*348 = 1432) emits the 96-pair chain. Runtime
; 132 + 214 = 346 (the BCs are NOT taken — r0 == 0, r5 == 0) takes
; the chain's NINETY-SIXTH b.eq, landing on block95's LOADI #987. The
; candidates are real pcs (block0..block47 at 52..146, block48..
; block95 at 252..346), as the chain branches straight to
; g_instr_off[pc]. Teeth: chain33 (80-value root, collapsed at 64) now
; chains — the equal-caps collapse at 64 was cap-specific, not
; structural (M2.57's Control A proved the same DAG chains under BIG
; > MAX); chain30 (100 values) still collapses conservatively at 96.
; Expected result: 987
.entry main
main:
    ENTER #8            ; pc 0
    LOADI r0, #0, i64   ; pc 1 — zero: every join BC below falls through
    LOADI r5, #0, i64   ; pc 2 — arm BC NOT taken at runtime (r5 = 0)
    LOADI r2, #52, i64 ; pc 3 — R1 branch-path base (52)
    BC r0, J2           ; pc 4 — falls through (delivers {r2:52} at J2)
    LOADI r2, #68, i64 ; pc 5 — R1 branch-path base (68)
    BC r0, J2           ; pc 6 — falls through (delivers {r2:68} at J2)
    LOADI r2, #84, i64 ; pc 7 — R1 branch-path base (84)
    BC r0, J2           ; pc 8 — falls through (delivers {r2:84} at J2)
    LOADI r2, #100, i64 ; pc 9 — R1 branch-path base (100)
    BC r0, J2           ; pc 10 — falls through (delivers {r2:100} at J2)
    LOADI r2, #116, i64 ; pc 11 — R1 branch-path base (116)
    BC r0, J2           ; pc 12 — falls through (delivers {r2:116} at J2)
    LOADI r2, #132, i64 ; pc 13 — fall-through base (132)
J2:                     ; (label) — join: r2 in {52, 68, 84, 100, 116, 132}
    LOADI r3, #0, i64 ; pc 14
    BC r0, J3           ; pc 15 — falls through (delivers {r3:0} at J3)
    LOADI r3, #2, i64 ; pc 16
    BC r0, J3           ; pc 17 — falls through (delivers {r3:2} at J3)
    LOADI r3, #4, i64 ; pc 18
    BC r0, J3           ; pc 19 — falls through (delivers {r3:4} at J3)
    LOADI r3, #6, i64 ; pc 20
    BC r0, J3           ; pc 21 — falls through (delivers {r3:6} at J3)
    LOADI r3, #8, i64 ; pc 22
    BC r0, J3           ; pc 23 — falls through (delivers {r3:8} at J3)
    LOADI r3, #10, i64 ; pc 24
    BC r0, J3           ; pc 25 — falls through (delivers {r3:10} at J3)
    LOADI r3, #12, i64 ; pc 26
    BC r0, J3           ; pc 27 — falls through (delivers {r3:12} at J3)
    LOADI r3, #14, i64 ; pc 28 — fall-through base (14)
J3:                     ; (label) — join: r3 in {0, 2, ..., 14}
    LOADI r6, #200, i64 ; pc 29
    BC r0, J6           ; pc 30 — falls through (delivers {r6:200} at J6)
    LOADI r6, #202, i64 ; pc 31
    BC r0, J6           ; pc 32 — falls through (delivers {r6:202} at J6)
    LOADI r6, #204, i64 ; pc 33
    BC r0, J6           ; pc 34 — falls through (delivers {r6:204} at J6)
    LOADI r6, #206, i64 ; pc 35
    BC r0, J6           ; pc 36 — falls through (delivers {r6:206} at J6)
    LOADI r6, #208, i64 ; pc 37
    BC r0, J6           ; pc 38 — falls through (delivers {r6:208} at J6)
    LOADI r6, #210, i64 ; pc 39
    BC r0, J6           ; pc 40 — falls through (delivers {r6:210} at J6)
    LOADI r6, #212, i64 ; pc 41
    BC r0, J6           ; pc 42 — falls through (delivers {r6:212} at J6)
    LOADI r6, #214, i64 ; pc 43 — fall-through base (214)
J6:                     ; (label) — join: r6 in {200, 202, ..., 214}
    ADD r1, r2, r3, i64 ; pc 44 — R1 = r2 + r3 in 48 values {52..146}
    BC r5, J            ; pc 45 — NOT taken (r5 == 0): delivers R1 at J
    ADD r1, r2, r6, i64 ; pc 46 — R2 = r2 + r6 in 48 values {252..346}
J:                      ; (label) — join: carry R2, arrival R1 — the 96-value union
    JMPR r1             ; pc 47 — candidates {52..146} U {252..346} (96),
                        ; runtime 132 + 214 = 346
    LOADI r0, #0, i32   ; pc 48 — dead filler
    LOADI r0, #0, i32   ; pc 49 — dead filler
    LOADI r0, #0, i32   ; pc 50 — dead filler
    LOADI r0, #0, i32   ; pc 51 — dead filler
