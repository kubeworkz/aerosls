; jmpr_chain33.simi — M2.57: the deferred-record pool AT its 64-cap
; (TX_AR_CHAIN_DEFS). The index is a 64-record DAG: the root product
; r1 = r2 + r3 (r2 in {0,20,...,140}, r3 in {0..18 step 2} -> ALL even
; numbers 0..158, 80 DISTINCT values > 64) OVERFLOWS the image merge
; cap, so the walk DEFERS it (M2.30: record 0, CD_SLOT/CD_SLOT). Then
; 63 IN-PLACE ADDs r1 = r1 + r4 with r4 = {2} (a singleton — the
; tracked-register closure stays {r1,r2,r3,r4} = 4 <= TX_AR_CHAIN_REGS
; 8): every product over the DEFERRED source defers (M2.32/M2.41:
; record k = op(rec(k-1), slot(r4))) — 63 more records, 64 total =
; TX_AR_CHAIN_DEFS EXACTLY, all allocating from the per-iteration
; pool (the walk confirms def = 63 on r1's slot at the dispatch).
; Under the shipped EQUAL caps the record machinery is conservative
; (the M2.42 vestigial note): the root's 80-value true set OVERFLOWS
; the BIG store on materialization (chain_merge_big collapses to
; UNKNOWN, exact-or-conservative — it never keeps a truncated set),
; so the dispatch falls to the TABLE — 0 b.eq, and runtime 252 (the
; joins' fall-through arms 120 + 6, plus 63*2) dispatches through the
; table's bounds check to block63's LOADI #7777. The two boundaries
; are pinned by the ad-hoc controls: (A) TX_AR_CHAIN_BIG raised to
; 128 — the same DAG materializes 80 values and the chain FIRES with
; the 64 in-range candidates (even 126..252), runtime 252 taking the
; SIXTY-FOURTH b.eq (sound when reachable); (B) a 65th in-place ADD
; — the pool is exhausted (g_chain_ndef >= 64 -> -1), r1 falls to
; UNKNOWN, and the dispatch is the table again (conservative, PASSes
; its runtime 256 through the bounds check). Dump-verified (shipped):
; 0 b.eq, the full table dispatch.
; Expected result: 7777
.entry main
main:
    ENTER #8            ; pc 0
    LOADI r0, #0, i64   ; pc 1 — zero: every join BC below falls through
    LOADI r2, #0, i64 ; pc 2 — r2 arm 0 (0)
    BC r0, J2           ; pc 3 — falls through (delivers {r2:0} at J2)
    LOADI r2, #20, i64 ; pc 4 — r2 arm 1 (20)
    BC r0, J2           ; pc 5 — falls through (delivers {r2:20} at J2)
    LOADI r2, #40, i64 ; pc 6 — r2 arm 2 (40)
    BC r0, J2           ; pc 7 — falls through (delivers {r2:40} at J2)
    LOADI r2, #60, i64 ; pc 8 — r2 arm 3 (60)
    BC r0, J2           ; pc 9 — falls through (delivers {r2:60} at J2)
    LOADI r2, #80, i64 ; pc 10 — r2 arm 4 (80)
    BC r0, J2           ; pc 11 — falls through (delivers {r2:80} at J2)
    LOADI r2, #100, i64 ; pc 12 — r2 arm 5 (100)
    BC r0, J2           ; pc 13 — falls through (delivers {r2:100} at J2)
    LOADI r2, #140, i64 ; pc 14 — r2 arm 6 (140)
    BC r0, J2           ; pc 15 — falls through (delivers {r2:140} at J2)
    LOADI r2, #120, i64 ; pc 16 — r2 arm 7 (120)
J2:                     ; (label) — join: r2 in {0,20,...,140}
    LOADI r3, #18, i64 ; pc 17 — r3 arm 0 (18)
    BC r0, J3           ; pc 18 — falls through (delivers {r3:18} at J3)
    LOADI r3, #16, i64 ; pc 19 — r3 arm 1 (16)
    BC r0, J3           ; pc 20 — falls through (delivers {r3:16} at J3)
    LOADI r3, #14, i64 ; pc 21 — r3 arm 2 (14)
    BC r0, J3           ; pc 22 — falls through (delivers {r3:14} at J3)
    LOADI r3, #12, i64 ; pc 23 — r3 arm 3 (12)
    BC r0, J3           ; pc 24 — falls through (delivers {r3:12} at J3)
    LOADI r3, #10, i64 ; pc 25 — r3 arm 4 (10)
    BC r0, J3           ; pc 26 — falls through (delivers {r3:10} at J3)
    LOADI r3, #8, i64 ; pc 27 — r3 arm 5 (8)
