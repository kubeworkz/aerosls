; jmpr_chain42.simi — M2.66: the deferred-UNION path probed at the
; EQUAL caps. M2.37 added the UNION record — a join mixing a
; deferred form with a NON-contained flat (or different-record)
; side materializes op(rec(R), flat(F)) instead of collapsing.
; This pin asks the structural question: can any UNION record
; survive at MAX = BIG = 96? The shape is chain13's skeleton
; scaled so the deferred side is a > 96-value product:
;   r2 in {0,10,...,90} (10 arms), r3 in {0..9} (10 arms)
;   R1 = r2 + r3 = ALL 100 values {0..99} DISTINCT (> MAX 96)
;         -> record 0 (the M2.30 overflow defer).
;   BC r5, J1 (r5 = 0, NOT taken) delivers R1 (deferred) at J1;
;   the flat arm writes r1 = #200 — OUTSIDE {0..99} — so the
;   M2.36 containment test FAILS and the M2.37 union path runs:
;   chain_def_alloc_union(CD_REC rec0, CD_FLAT {200}) flattens
;   its record side — rec0's 100-value true set OVERFLOWS the
;   BIG store (chain_merge_big -> UNKNOWN), the allocator
;   returns -1, and r1 falls to FLAT UNKNOWN at the walk
;   (instrumented: ndef = 1, r1's def = -1) — the dispatch is
;   the TABLE, 0 b.eq. Runtime 232 (90 + 9 = 99 at the root, the
;   flat arm's 200, then +32 = 232) passes the bounds check to
;   block0 at pc 232 -> LOADI #4200, on all four engines.
; The control (BIG=128 ad hoc, the M2.55 direction): rec0's
; materialization now FITS the store (100 <= 128), the union
; record IS created (instrumented: ndef = 3, r1's def = 2 — the
; union + the in-place add), and the dispatch materializes
; {32..131} U {232} = 101 candidates <= BIG -> the 101-pair
; chain FIRES (runtime 232 = the LAST b.eq). The probe therefore
; proves the cap check is the binding constraint: the union
; path is REACHED, and it is the allocator's BIG-store check
; that makes it unreachable at equal caps. 232 is the 101st
; candidate — any truncated materialization misses it and
; UDF-traps, so the four-way PASS proves the collapse is exact.
; Expected result: 4200
.entry main
main:
    ENTER #8            ; pc 0
    LOADI r0, #0, i64   ; pc 1 — zero: every join BC below falls through
    LOADI r5, #0, i64   ; pc 2 — flat-arm BC NOT taken at runtime (r5 = 0)
    LOADI r4, #32, i64  ; pc 3 — r4 = {32} (the in-place add amount, a singleton)
    LOADI r2, #0, i64 ; pc 4 — r2 arm 0 (0)
    BC r0, J2           ; pc 5 — falls through (delivers {r2:0} at J2)
    LOADI r2, #10, i64 ; pc 6 — r2 arm 1 (10)
    BC r0, J2           ; pc 7 — falls through (delivers {r2:10} at J2)
    LOADI r2, #20, i64 ; pc 8 — r2 arm 2 (20)
    BC r0, J2           ; pc 9 — falls through (delivers {r2:20} at J2)
    LOADI r2, #30, i64 ; pc 10 — r2 arm 3 (30)
    BC r0, J2           ; pc 11 — falls through (delivers {r2:30} at J2)
    LOADI r2, #40, i64 ; pc 12 — r2 arm 4 (40)
    BC r0, J2           ; pc 13 — falls through (delivers {r2:40} at J2)
    LOADI r2, #50, i64 ; pc 14 — r2 arm 5 (50)
    BC r0, J2           ; pc 15 — falls through (delivers {r2:50} at J2)
    LOADI r2, #60, i64 ; pc 16 — r2 arm 6 (60)
    BC r0, J2           ; pc 17 — falls through (delivers {r2:60} at J2)
    LOADI r2, #70, i64 ; pc 18 — r2 arm 7 (70)
    BC r0, J2           ; pc 19 — falls through (delivers {r2:70} at J2)
    LOADI r2, #80, i64 ; pc 20 — r2 arm 8 (80)
    BC r0, J2           ; pc 21 — falls through (delivers {r2:80} at J2)
    LOADI r2, #90, i64 ; pc 22 — r2 arm 9 (90) fall-through base
J2:                     ; (label) — join: r2 in {0,10,...,90}
    LOADI r3, #0, i64 ; pc 23 — r3 arm 0 (0)
    BC r0, J3           ; pc 24 — falls through (delivers {r3:0} at J3)
    LOADI r3, #1, i64 ; pc 25 — r3 arm 1 (1)
    BC r0, J3           ; pc 26 — falls through (delivers {r3:1} at J3)
    LOADI r3, #2, i64 ; pc 27 — r3 arm 2 (2)
    BC r0, J3           ; pc 28 — falls through (delivers {r3:2} at J3)
    LOADI r3, #3, i64 ; pc 29 — r3 arm 3 (3)
    BC r0, J3           ; pc 30 — falls through (delivers {r3:3} at J3)
    LOADI r3, #4, i64 ; pc 31 — r3 arm 4 (4)
    BC r0, J3           ; pc 32 — falls through (delivers {r3:4} at J3)
    LOADI r3, #5, i64 ; pc 33 — r3 arm 5 (5)
    BC r0, J3           ; pc 34 — falls through (delivers {r3:5} at J3)
    LOADI r3, #6, i64 ; pc 35 — r3 arm 6 (6)
    BC r0, J3           ; pc 36 — falls through (delivers {r3:6} at J3)
    LOADI r3, #7, i64 ; pc 37 — r3 arm 7 (7)
    BC r0, J3           ; pc 38 — falls through (delivers {r3:7} at J3)
    LOADI r3, #8, i64 ; pc 39 — r3 arm 8 (8)
    BC r0, J3           ; pc 40 — falls through (delivers {r3:8} at J3)
    LOADI r3, #9, i64 ; pc 41 — r3 arm 9 (9) fall-through base
J3:                     ; (label) — join: r3 in {0..9}
    ADD r1, r2, r3, i64 ; pc 42 — R1: 100 values {0..99} > 96 -> record 0 (overflow defer)
    BC r5, J1           ; pc 43 — NOT taken at runtime (r5 == 0): delivers R1 (deferred) at J1
    LOADI r1, #200, i64 ; pc 44 — flat arm (the runtime path): r1 = #200 (NOT in {0..99}) — M2.37 union
J1:                     ; (label) — join: carry {r1:200}, arrival R1 (deferred) — M2.37 UNION path
    ADD r1, r1, r4, i64 ; pc 45 — in-place over the union (or UNKNOWN): r1 = r1 + 32
    JMPR r1             ; pc 46 — table dispatch; runtime 200 + 32 = 232
    LOADI r0, #0, i32   ; pc 47 — dead filler
    LOADI r0, #0, i32   ; pc 48 — dead filler
    LOADI r0, #0, i32   ; pc 49 — dead filler
    LOADI r0, #0, i32   ; pc 50 — dead filler
    LOADI r0, #0, i32   ; pc 51 — dead filler
    LOADI r0, #0, i32   ; pc 52 — dead filler
    LOADI r0, #0, i32   ; pc 53 — dead filler
