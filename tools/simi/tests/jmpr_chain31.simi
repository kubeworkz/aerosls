; jmpr_chain31.simi — M2.55: the cap-divergence boundary pinned from the
; shipped side. The M2.54 control proved the MAX > BIG direction is
; overflow-free (chain_flatten_big collapses); the mirror is BIG > MAX —
; the union store's frozen g_chain_def_flat is BIG-shaped, so a deferred
; record whose true set exceeds the walk's flat bound (TX_AR_CHAIN_MAX)
; materializes soundly through the BIG path (chain_flatten_big_rec, the
; dispatch snapshot) and collapses conservatively at the walk path
; (the M2.41 guards: st->n > TX_AR_CHAIN_MAX -> UNKNOWN). Under the
; shipped EQUAL caps (96/96, M2.61) that divergence is unreachable — a
; record's store can hold at most 96, and 96 is exactly the flat bound.
; At the M2.55-era caps (64/64) this fixture WAS the TURN-OVER BOUNDARY
; (n == MAX == BIG, exactly 64 values); after M2.61's equal bump the
; same 64-value union now sits BELOW the cap and materializes FLAT — the
; record machinery never engages (instrumented ndef=0 at M2.64). The
; fixture still fires its 64-pair chain (the union path is unchanged);
; the turn-over boundary itself moved to chain37 (96 values, M2.61) and
; chain30 (100 values, collapses). A truncated materialization (a guard
; that kept only 63, or a store one short) would miss the runtime index
; and UDF-trap — the discriminator.
; The index: the union of two products, mirroring chain16's R-arm shape.
; R1 = r2 + r3 (r2 in {44,60,76,92}, r3 in {0,2,...,14} -> THIRTY-TWO
; values {44..106} step 2) and R2 = r2 + r6 (r6 in {108,110,...,122} ->
; THIRTY-TWO values {152..214} step 2); the union {44..106} ∪ {152..214}
; = 64 DISTINCT values (64 < 96, below the equal caps — the "deferred"
; union-record machinery never engages; the walk unions the two flat
; images, instrumented ndef=0 at M2.64). The R-arm's `BC r5, J` (r5 = 0,
; not taken) delivers R1 into J; the fall-through computes R2 and flows
; in as the carry, so J's head-union joins the two flat sets. The gate
; (8*64+4 = 516 < 40 + 4*216 = 904) emits the 64-pair chain. Runtime 92 + 122 = 214
; (the BCs are NOT taken — r0 == 0, r5 == 0) takes the chain's
; SIXTY-FOURTH b.eq, landing on block63's LOADI #555. The candidates are
; real pcs (block0..block31 at 44..106, block32..block63 at 152..214),
; as the chain branches straight to g_instr_off[pc].
; Expected result: 555
.entry main
main:
    ENTER #8            ; pc 0
    LOADI r0, #0, i64   ; pc 1 — zero: every join BC below falls through
    LOADI r5, #0, i64   ; pc 2 — arm BC NOT taken at runtime (r5 = 0)
    LOADI r2, #44, i64  ; pc 3 — R1 branch-path base (44) — dead at runtime
    BC r0, J2           ; pc 4 — falls through (delivers {r2:44} at J2)
    LOADI r2, #60, i64  ; pc 5
    BC r0, J2           ; pc 6 — falls through (delivers {r2:60} at J2)
    LOADI r2, #76, i64  ; pc 7
    BC r0, J2           ; pc 8 — falls through (delivers {r2:76} at J2)
    LOADI r2, #92, i64  ; pc 9 — fall-through base (92)
J2:                     ; (label) — join: r2 in {44, 60, 76, 92}
    LOADI r3, #0, i64   ; pc 10
    BC r0, J3           ; pc 11 — falls through (delivers {r3:0} at J3)
    LOADI r3, #2, i64   ; pc 12
    BC r0, J3           ; pc 13 — falls through (delivers {r3:2} at J3)
    LOADI r3, #4, i64   ; pc 14
    BC r0, J3           ; pc 15 — falls through (delivers {r3:4} at J3)
    LOADI r3, #6, i64   ; pc 16
    BC r0, J3           ; pc 17 — falls through (delivers {r3:6} at J3)
    LOADI r3, #8, i64   ; pc 18
    BC r0, J3           ; pc 19 — falls through (delivers {r3:8} at J3)
    LOADI r3, #10, i64  ; pc 20
    BC r0, J3           ; pc 21 — falls through (delivers {r3:10} at J3)
    LOADI r3, #12, i64  ; pc 22
    BC r0, J3           ; pc 23 — falls through (delivers {r3:12} at J3)
    LOADI r3, #14, i64  ; pc 24 — fall-through base (14)
J3:                     ; (label) — join: r3 in {0, 2, ..., 14}
    LOADI r6, #108, i64 ; pc 25
    BC r0, J6           ; pc 26 — falls through (delivers {r6:108} at J6)
    LOADI r6, #110, i64 ; pc 27
    BC r0, J6           ; pc 28 — falls through (delivers {r6:110} at J6)
    LOADI r6, #112, i64 ; pc 29
    BC r0, J6           ; pc 30 — falls through (delivers {r6:112} at J6)
    LOADI r6, #114, i64 ; pc 31
    BC r0, J6           ; pc 32 — falls through (delivers {r6:114} at J6)
    LOADI r6, #116, i64 ; pc 33
    BC r0, J6           ; pc 34 — falls through (delivers {r6:116} at J6)
    LOADI r6, #118, i64 ; pc 35
    BC r0, J6           ; pc 36 — falls through (delivers {r6:118} at J6)
    LOADI r6, #120, i64 ; pc 37
    BC r0, J6           ; pc 38 — falls through (delivers {r6:120} at J6)
    LOADI r6, #122, i64 ; pc 39 — fall-through base (122)
J6:                     ; (label) — join: r6 in {108, 110, ..., 122}
    ADD r1, r2, r3, i64 ; pc 40 — R1 = r2 + r3 in 32 values {44..106} — DEFERS
    BC r5, J            ; pc 41 — NOT taken (r5 == 0): delivers R1 (deferred) at J
    ADD r1, r2, r6, i64 ; pc 42 — R2 = r2 + r6 in 32 values {152..214} — DEFERS
                        ; (replaces R1)
J:                      ; (label) — join: carry R2, arrival R1 — UNION record
                        ; (64 values, exactly MAX = BIG)
    JMPR r1             ; pc 43 — candidates {44..106} ∪ {152..214} (64),
                        ; runtime 92 + 122 = 214
