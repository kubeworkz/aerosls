; alu_imm.simi — M2.6/M2.7: ADD/SUB immediates fold into A64's
; add-imm/sub-imm forms (one word) instead of the movz(+movk)+add_shift
; materialization — the same fold LEA/PTRADD/LOAD already do for
; displacements. The chain exercises the plain rows (5, 3, 100, 55, the
; exact 4095 boundary), then the two rows M2.6 could NOT fold that M2.7
; closes: 4096 (the smallest imm12<<12 shifted form, add #1, lsl #12)
; and #-5 (a negative SUB inverts to add #5); the register-form ADD
; stays a non-fold by nature. The still-non-folding immediate ranges
; (|imm| past 0xFFFFFF, non-multiples of 4096 past 4095) are covered by
; alu_imm_ext.simi; the teeth check (disabling the fold) grows this
; test back to the M2.6 size, 1100.
; r1 = 10
; r2 = r1 + 5  = 15    (fold sh=0: add #5)
; r3 = r2 - 3  = 12    (fold sh=0: sub #3)
; r4 = r3 + 100 = 112  (fold sh=0: add #100)
; r5 = r4 - 55 = 57    (fold sh=0: sub #55)
; r6 = r5 + 4095 = 4152 (fold sh=0: add #4095, exact imm12 boundary)
; r7 = r6 + 4096 = 8248 (fold sh=1: add #1, lsl #12)
; r8 = r7 - -5 = 8253  (fold: negative SUB inverts to add #5)
; r9 = r8 + r2 = 8268  (register form)
; r0 = r9 = 8268
; Expected result: 8268
.entry main
main:
    ENTER #8
    LOADI r1, #10, i64
    ADD r2, r1, #5, i64
    SUB r3, r2, #3, i64
    ADD r4, r3, #100, i64
    SUB r5, r4, #55, i64
    ADD r6, r5, #4095, i64   ; 4152 (fold sh=0 — exact imm12 boundary)
    ADD r7, r6, #4096, i64   ; 8248 (fold sh=1 — add #1, lsl #12)
    SUB r8, r7, #-5, i64     ; 8253 (fold — negative SUB inverts to add #5)
    ADD r9, r8, r2, i64      ; 8268 (register form — no imm to fold)
    LOADI r0, #0, i64
    ADD r0, r0, r9, i64
    RET
