; mem_neg.simi — M2.8: LOAD/STORE displacement address math. A negative
; displacement used to fall to the movz(+movk)+add_shift materialization
; even at |disp| <= 4095, because A64's scaled load/store immediate is
; unsigned — now the address math folds |disp| into a single add/sub-imm
; (plain 0..4095, or the shifted imm12<<12 form for multiples of 4096),
; the same imm12_split the ALU immediate fold uses. The rows:
;   [r6-8]     fold M2.10: unscaled     -> r7+4079  (aligned i32 in imm9:
;               stur_w/ldur_w #-8 — one word; M2.9 emitted the pre-indexed
;               form, M2.8 sub #8 + access)
;   [r5-4096]  fold sh=1: sub #1,lsl#12 -> r7+565   (shifted negative; |disp| > 255,
;               so the unscaled imm9 cannot take it)
;   [r5-4101]  fold M2.11: reg-offset  -> r7+560   (|disp| > 4095 and not
;               a multiple of 4096: the materialize path puts the
;               displacement in a scratch (X_T2, clobbered first) and the
;               access is ONE ldr/str x, [x, xm] word — M2.8's honest
;               fallback was li64 + add_shift + zero-offset access)
;   [r6+5]     fold M2.10: unscaled     -> r7+4092  (positive but UNALIGNED
;               for i32 — the scaled fast path rejects it and M2.9's
;               aligned-only pre-indexed form rejected it too; the unscaled
;               form needs no alignment and folds #5 in one word)
; All four i32 addresses stay >= 4 bytes apart (an earlier draft used
; -4096 and -4097 — one byte apart — and the i32 stores overlapped; the
; four-way parity caught it as a wrong result — an address-overlap bug
; in the test's own design, not in the translator).
; The effective offsets are confined to r7+[560, 4092], the band portable
; across all four engines' r7 scratch conventions: x86's r7 is a host
; pointer into a 4096-byte mmap (offsets in [0, 4096), and a 4-byte i32
; access must end before offset 4096), ARM/RV64's r7 is scratch_ptr
; mid-buffer with the 576-byte frame occupying offsets [-16, 560) from
; it, and the interpreter's r7 is 0 with a 64 KiB mem. The bases are
; built with folding LEA/ADD (pure arithmetic, never dereferenced):
; r5 = r7 + 4661 = LEA #4095 + ADD #566, r6 = r7 + 4087 = LEA #4087.
; Round-tripping store->load at the same address proves the address math
; is consistent.
; r1 = 100, r2 = 200
; [r6-8]=100, [r5-4096]=200, [r5-4101]=100, [r6+5]=200
; r3=100, r4=200, r8=100, r9=200
; r0 = 100 + 200 + 100 + 200 = 600
; Expected result: 600
.entry main
main:
    ENTER #12
    LOADI r1, #100, i32
    LOADI r2, #200, i32
    LEA r5, r7, #4095          ; r5 = r7 + 4095 (fold: add #4095)
    ADD r5, r5, #566, i32      ; r5 = r7 + 4661 (fold: add #566)
    LEA r6, r7, #4087          ; r6 = r7 + 4087 (fold: add #4087)
    STORE r1, r6, #-8, i32
    STORE r2, r5, #-4096, i32
    STORE r1, r5, #-4101, i32
    STORE r2, r6, #5, i32
    LOAD r3, r6, #-8, i32
    LOAD r4, r5, #-4096, i32
    LOAD r8, r5, #-4101, i32
    LOAD r9, r6, #5, i32
    ADD r0, r3, r4, i32
    ADD r0, r0, r8, i32
    ADD r0, r0, r9, i32
    RET
