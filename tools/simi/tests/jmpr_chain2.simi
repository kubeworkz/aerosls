; jmpr_chain2.simi — M2.26: the inline chain extended to an index BUILT
; BY ARITHMETIC. The dispatch index is r1 = 2 + r2, where r2 is the join-
; dependent base (8 on the never-taken branch path, 10 on the taken
; fall-through) — so the candidate set is the PAIR PRODUCT over the two
; tracked registers: {2} + {8, 10} = {10, 12}. Under M2.25 this could
; not chain (the register-form ADD's source was opaque to the single-
; register walk); M2.26's tracked-register closure (ra + its feeder r2)
; follows it, and the runtime index 12 takes the chain's SECOND b.eq —
; the same second-candidate shape jmpr_chain pins, now through a
; register ADD instead of a bare LOADI. The fold fixpoint cannot fold
; the JMPR (r2 is join-dependent — same reset argument as jmpr_join),
; so g_alloc=0 and the chain is the naive-mode dispatch. Candidates 10
; and 12 are real pcs (blockA/blockB), as the chain branches straight
; to g_instr_off[candidate].
; Expected result: 333
.entry main
main:
    ENTER #8            ; pc 0
    LOADI r0, #0, i64   ; pc 1 — zero: the BC below NEVER branches
    LOADI r1, #2, i64   ; pc 2 — the constant part of the index
    LOADI r2, #8, i64   ; pc 3 — branch-path base (8) — dead at runtime
    BC r0, L            ; pc 4 — r0 == 0 → falls through (delivers {r1:2, r2:8} at the join)
    LOADI r2, #10, i64  ; pc 5 — fall-through base (10)
L:                      ; pc 6 — join: r2 ∈ {8, 10}
    ADD r1, r1, r2, i64 ; pc 6 — r1 = 2 + r2 ∈ {10, 12}
    JMPR r1             ; pc 7 — candidates {10, 12}, runtime 12
    LOADI r0, #111, i32 ; pc 8 — dead path — never reached
    RET                 ; pc 9
blockA:                 ; pc 10 — candidate 10's landing (never hit: BC falls through)
    LOADI r0, #222, i32 ; pc 10
    RET                 ; pc 11
blockB:                 ; pc 12 — candidate 12's landing (runtime hit)
    LOADI r0, #333, i32 ; pc 12
    RET                 ; pc 13
