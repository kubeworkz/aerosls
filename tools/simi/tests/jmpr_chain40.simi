; jmpr_chain40.simi — M2.64: the deferred-record pool AT its NEW
; 96-cap (TX_AR_CHAIN_DEFS 64 -> 96, the EQUAL-CAPS regression's
; third dimension — M2.61 did the set caps MAX/BIG, M2.62 the
; register closure REGS). The index is a 96-record DAG:
;   root: r1 = r2 + r3, r2 in {0,10,...,90} (10 arms), r3 in
;         {0..9} (10 arms) -> ALL 100 values {0..99} DISTINCT
;         (> TX_AR_CHAIN_MAX 96) -> chain_img_alu overflows
;         -> the M2.30 deferral: record 0 (op ADD, CD_SLOT r2,
;         CD_SLOT r3).
;   95 in-place ADDs r1 = r1 + r4, r4 = {2} (a flat singleton;
;         the closure {r1,r2,r3,r4} = 4 <= TX_AR_CHAIN_REGS
;         12): every product over the DEFERRED source defers
;         (M2.32/M2.41: record k = op(ADD, rec(k-1), CD_SLOT
;         r4)) — records 1..95, 96 total = TX_AR_CHAIN_DEFS
;         EXACTLY, all allocating from the per-iteration pool
;         (instrumented: ndef = 96, r1's def = 95 at the
;         dispatch).
; Under the EQUAL caps the machinery is conservative: the
; root's 100-value true set OVERFLOWS the BIG store on
; materialization (chain_merge_big collapses to UNKNOWN —
; exact-or-conservative, it never keeps a truncated set), so
; the dispatch falls to the TABLE — 0 b.eq, and runtime 289
; (the joins' fall-through arms 90 + 9, plus 95*2) dispatches
; through the table's bounds check to block0 at pc 289 ->
; LOADI #7777. The discriminator: 289 is the HUNDREDTH value
; of the true set {190..289} — ANY truncated materialization
; (96, 97, 98, or 99 candidates) misses it and UDF-traps
; (rc=1), so the four-way parity PASS proves the collapse is
; exact, not truncated. The boundary itself is pinned by the
; ad-hoc control (DEFS=95): the 96th allocation returns -1
; (pool exhausted), r1 falls to FLAT UNKNOWN at the walk, and
; the dispatch is the table again — the SAME bytes, a
; DIFFERENT mechanism (walk-state UNKNOWN vs materialization
; collapse), proven by the instrumentation. The M2.57 64-
; record boundary is a fossil: chain33's root (80 values)
; stays FLAT at MAX=96 and never touches the pool
; (instrumented ndef = 0), so the pool is a pure ceiling on
; DAG depth.
; Expected result: 7777
.entry main
main:
    ENTER #8            ; pc 0
    LOADI r0, #0, i64   ; pc 1 — zero: every join BC below falls through
    LOADI r2, #0, i64 ; pc 2 — r2 arm 0 (0)
    BC r0, J2           ; pc 3 — falls through (delivers {r2:0} at J2)
    LOADI r2, #10, i64 ; pc 4 — r2 arm 1 (10)
    BC r0, J2           ; pc 5 — falls through (delivers {r2:10} at J2)
    LOADI r2, #20, i64 ; pc 6 — r2 arm 2 (20)
    BC r0, J2           ; pc 7 — falls through (delivers {r2:20} at J2)
    LOADI r2, #30, i64 ; pc 8 — r2 arm 3 (30)
    BC r0, J2           ; pc 9 — falls through (delivers {r2:30} at J2)
    LOADI r2, #40, i64 ; pc 10 — r2 arm 4 (40)
    BC r0, J2           ; pc 11 — falls through (delivers {r2:40} at J2)
    LOADI r2, #50, i64 ; pc 12 — r2 arm 5 (50)
    BC r0, J2           ; pc 13 — falls through (delivers {r2:50} at J2)
    LOADI r2, #60, i64 ; pc 14 — r2 arm 6 (60)
    BC r0, J2           ; pc 15 — falls through (delivers {r2:60} at J2)
    LOADI r2, #70, i64 ; pc 16 — r2 arm 7 (70)
    BC r0, J2           ; pc 17 — falls through (delivers {r2:70} at J2)
    LOADI r2, #80, i64 ; pc 18 — r2 arm 8 (80)
    BC r0, J2           ; pc 19 — falls through (delivers {r2:80} at J2)
    LOADI r2, #90, i64 ; pc 20 — r2 arm 9 (90) fall-through base
J2:                     ; (label) — join: r2 in {0,10,...,90}
    LOADI r3, #0, i64 ; pc 21 — r3 arm 0 (0)
    BC r0, J3           ; pc 22 — falls through (delivers {r3:0} at J3)
    LOADI r3, #1, i64 ; pc 23 — r3 arm 1 (1)
    BC r0, J3           ; pc 24 — falls through (delivers {r3:1} at J3)
    LOADI r3, #2, i64 ; pc 25 — r3 arm 2 (2)
    BC r0, J3           ; pc 26 — falls through (delivers {r3:2} at J3)
    LOADI r3, #3, i64 ; pc 27 — r3 arm 3 (3)
    BC r0, J3           ; pc 28 — falls through (delivers {r3:3} at J3)
    LOADI r3, #4, i64 ; pc 29 — r3 arm 4 (4)
    BC r0, J3           ; pc 30 — falls through (delivers {r3:4} at J3)
    LOADI r3, #5, i64 ; pc 31 — r3 arm 5 (5)
    BC r0, J3           ; pc 32 — falls through (delivers {r3:5} at J3)
    LOADI r3, #6, i64 ; pc 33 — r3 arm 6 (6)
    BC r0, J3           ; pc 34 — falls through (delivers {r3:6} at J3)
    LOADI r3, #7, i64 ; pc 35 — r3 arm 7 (7)
    BC r0, J3           ; pc 36 — falls through (delivers {r3:7} at J3)
    LOADI r3, #8, i64 ; pc 37 — r3 arm 8 (8)
    BC r0, J3           ; pc 38 — falls through (delivers {r3:8} at J3)
    LOADI r3, #9, i64 ; pc 39 — r3 arm 9 (9) fall-through base
J3:                     ; (label) — join: r3 in {0..9}
    ADD r1, r2, r3, i64 ; pc 40 — root: 100 values {0..99} > 96 -> record 0 (overflow defer)
    LOADI r4, #2, i64 ; pc 41 — r4 = {2} (flat singleton)
