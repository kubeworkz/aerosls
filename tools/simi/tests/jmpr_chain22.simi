; jmpr_chain22.simi — M2.46: TWO index generations over one tracked
; feeder. The chain machinery requires exactly ONE dynamic JMPR, so the
; probe puts both generations in the SAME register with ONE dispatch:
;   pc 18 (build1): r1 = r2 + r3 -> TWENTY values {42..80} (stored image)
;   pc 19:          LOADI r3, #100  (TRACKED rewrite of the feeder r3)
;   pc 20 (build2): r1 = r1 + r3    (in-place, reads the OLD r1 image
;                   and the NEW r3) -> TWENTY values {142..180}
;   pc 21:          JMPR r1         (chains on the SECOND image)
; Each generation's image is computed from the feeder's value AT THAT
; BUILD: build1 uses r3's join set {40..48}, build2 uses r3's new
; singleton {100} — while r1's STORED image from build1 must survive
; the LOADI untouched (M2.44's mechanism, now with a TRACKED writer).
; The two generations COEXIST: the second image is the old r1 snapshot
; PLUS the new r3, so a bug in either independence breaks the chain:
;   - re-derive r1's image at the LOADI -> {102..132}, build2 = {202..232}
;   - stale r3 at build2 -> {82..128}
;   - in-place read-after-write -> {202..232}
; ...all of which MISS the runtime index 80 + 100 = 180 and UDF-trap.
; The runtime takes the chain's TWENTIETH b.eq (180 = 142 + 2*19),
; landing on block19's LOADI #2000. Candidates are real pcs (blocks at
; 142..180 — the JMPR jumps to pc == index). Gate: 164 < 40 + 4*182.
; Expected result: 2000
.entry main
main:
    ENTER #8            ; pc 0
    LOADI r0, #0, i64   ; pc 1 — zero: every join BC below falls through
    LOADI r2, #2, i64   ; pc 2 — branch-path base (2) — dead at runtime
    BC r0, J2           ; pc 3 — falls through (delivers {r2:2} at J2)
    LOADI r2, #12, i64  ; pc 4
    BC r0, J2           ; pc 5 — falls through (delivers {r2:12} at J2)
    LOADI r2, #22, i64  ; pc 6
    BC r0, J2           ; pc 7 — falls through (delivers {r2:22} at J2)
    LOADI r2, #32, i64  ; pc 8 — fall-through base (32)
J2:                     ; (label) — join: r2 in {2, 12, 22, 32}
    LOADI r3, #40, i64  ; pc 9
    BC r0, J3           ; pc 10 — falls through (delivers {r3:40} at J3)
    LOADI r3, #42, i64  ; pc 11
    BC r0, J3           ; pc 12 — falls through (delivers {r3:42} at J3)
    LOADI r3, #44, i64  ; pc 13
    BC r0, J3           ; pc 14 — falls through (delivers {r3:44} at J3)
    LOADI r3, #46, i64  ; pc 15
    BC r0, J3           ; pc 16 — falls through (delivers {r3:46} at J3)
    LOADI r3, #48, i64  ; pc 17 — fall-through base (48)
J3:                     ; (label) — join: r3 in {40,42,44,46,48}
    ADD r1, r2, r3, i64 ; pc 18 — GENERATION 1: r1 = r2 + r3 = 20 values
                        ; (42..80 evens). Stored image in r1's slot.
    LOADI r3, #100, i64 ; pc 19 — TRACKED rewrite of the FEEDER r3:
                        ; cur[r3] becomes {100}. r1's stored image is
                        ; untouched (the write updates only r3's slot).
    ADD r1, r1, r3, i64 ; pc 20 — GENERATION 2, IN-PLACE on r1: reads
                        ; the OLD r1 image {42..80} and the NEW r3
                        ; {100} -> {142..180}. The two generations
                        ; COEXIST in one image — the independence pin.
    JMPR r1             ; pc 21 — candidates {142,144,...,180}, runtime
                        ; 32 + 48 = 80 then + 100 = 180 (twentieth).
    LOADI r0, #0, i32   ; pc 22 — dead filler (aligns block0 to pc 142)
    LOADI r0, #0, i32   ; pc 23
    LOADI r0, #0, i32   ; pc 24
    LOADI r0, #0, i32   ; pc 25
    LOADI r0, #0, i32   ; pc 26
    LOADI r0, #0, i32   ; pc 27
    LOADI r0, #0, i32   ; pc 28
    LOADI r0, #0, i32   ; pc 29
    LOADI r0, #0, i32   ; pc 30
    LOADI r0, #0, i32   ; pc 31
    LOADI r0, #0, i32   ; pc 32
    LOADI r0, #0, i32   ; pc 33
