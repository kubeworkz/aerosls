; jmpr_chain38.simi — M2.62: the tracked-register closure AT its NEW
; 12-cap. M2.56 pinned the 8-cap turn-over (jmpr_chain32); M2.62
; raises TX_AR_CHAIN_REGS 8 -> 12 (the EQUAL-CAPS regression's
; register dimension) and this pin regression-guards the new
; boundary: a closure needing EXACTLY TWELVE registers — the largest
; the cap admits. The index is built in stages over joins:
;   r8 in {0, 10}                    (2-way join)
;   r4 = r8 + r8    -> {0, 20}       (self-add: r8 tracked ONCE)
;   r9 in {0, 10}, r10 in {0, 5}     (2-way joins)
;   r5 = r9 + r10   -> {0,5,10,15}
;   r2 = r4 + r5    -> {0..35 step 5}   (8 values)
;   r11 in {40, 50}, r12 in {0, 5}   (2-way joins)
;   r6 = r11 + r12  -> {40,45,50,55}
;   r7 in {0, 200, 400}              (3-way join)
;   r3 = r6 + r7    -> 12 values in 3 disjoint ranges
;   r1 = r2 + r3    -> THIRTY-THREE values {40..90} U {240..290} U
;                      {440..490} step 5
; The tracked closure is {r1, r2, ..., r12} — TWELVE registers,
; exactly TX_AR_CHAIN_REGS: every feeder is tracked and the 33-
; candidate chain fires (the gate: 8*33+4 = 268 < 40 + 4*495 = 2020).
; A closure needing a THIRTEENTH register would stop growing at 12
; — the extra feeder untracked, its set UNKNOWN, r1 falls to the
; table (conservative and correct, dump shows 0 b.eq; verified as
; the ad-hoc control). The runtime index 10 + (10+5) + (50+5) + 400
; = 490 (all join BCs fall through, r0 == 0) is the LAST of the 33
; candidates and takes the chain's THIRTY-THIRD b.eq, landing on
; block32's LOADI #3200 — a truncated image (a 32-candidate chain,
; or one feeder dropped) would miss 490 and UDF-trap (rc=1): the
; discriminator. The candidates are real pcs (block0..block10 at
; 40..90, block11..block21 at 240..290, block22..block32 at 440..490,
; step 5, each block LOADI+RET + 3 spacers), as the chain branches
; straight to g_instr_off[pc].
; Expected result: 3200
.entry main
main:
    ENTER #8            ; pc 0
    LOADI r0, #0, i64   ; pc 1 — zero: every join BC below falls through
    LOADI r8, #0, i64 ; pc 2
    BC r0, J8           ; pc 3 — falls through (delivers {r8:0} at J8)
    LOADI r8, #10, i64 ; pc 4 — fall-through base (10)
J8:                     ; (label) — join: r8 in {0, 10}
    ADD r4, r8, r8, i64 ; pc 5 — r4 = r8 + r8 = {0, 20} (r8 tracked once)
    LOADI r9, #0, i64 ; pc 6
    BC r0, J9           ; pc 7 — falls through (delivers {r9:0} at J9)
    LOADI r9, #10, i64 ; pc 8 — fall-through base (10)
J9:                     ; (label) — join: r9 in {0, 10}
    LOADI r10, #0, i64 ; pc 9
    BC r0, J10           ; pc 10 — falls through (delivers {r10:0} at J10)
    LOADI r10, #5, i64 ; pc 11 — fall-through base (5)
J10:                     ; (label) — join: r10 in {0, 5}
    ADD r5, r9, r10, i64 ; pc 12 — r5 = r9 + r10 = {0,5,10,15}
    ADD r2, r4, r5, i64 ; pc 13 — r2 = r4 + r5 = {0..35 step 5}
    LOADI r11, #40, i64 ; pc 14
    BC r0, J11           ; pc 15 — falls through (delivers {r11:40} at J11)
    LOADI r11, #50, i64 ; pc 16 — fall-through base (50)
J11:                     ; (label) — join: r11 in {40, 50}
    LOADI r12, #0, i64 ; pc 17
    BC r0, J12           ; pc 18 — falls through (delivers {r12:0} at J12)
    LOADI r12, #5, i64 ; pc 19 — fall-through base (5)
J12:                     ; (label) — join: r12 in {0, 5}
    ADD r6, r11, r12, i64 ; pc 20 — r6 = r11 + r12 = {40,45,50,55}
    LOADI r7, #0, i64 ; pc 21
    BC r0, J7           ; pc 22 — falls through (delivers {r7:0} at J7)
    LOADI r7, #200, i64 ; pc 23
    BC r0, J7           ; pc 24 — falls through (delivers {r7:200} at J7)
    LOADI r7, #400, i64 ; pc 25 — fall-through base (400)
J7:                     ; (label) — join: r7 in {0, 200, 400}
    ADD r3, r6, r7, i64 ; pc 26 — r3 = r6 + r7 (12 values)
    ADD r1, r2, r3, i64 ; pc 27 — r1 = r2 + r3 = 33 values {40..90} U
                        ; {240..290} U {440..490} step 5
                        ; M2.62: the closure {r1..r12} = TWELVE
                        ; registers, exactly TX_AR_CHAIN_REGS — a
                        ; thirteenth feeder would truncate to the
                        ; table (conservative).
    JMPR r1             ; pc 28 — candidates {40..90, 240..290, 440..490},
                        ; runtime 10+(10+5)+(50+5)+400 = 490 (the last)
    LOADI r0, #0, i32   ; pc 29 — dead filler
    LOADI r0, #0, i32   ; pc 30 — dead filler
    LOADI r0, #0, i32   ; pc 31 — dead filler
    LOADI r0, #0, i32   ; pc 32 — dead filler
    LOADI r0, #0, i32   ; pc 33 — dead filler
    LOADI r0, #0, i32   ; pc 34 — dead filler
    LOADI r0, #0, i32   ; pc 35 — dead filler
    LOADI r0, #0, i32   ; pc 36 — dead filler
    LOADI r0, #0, i32   ; pc 37 — dead filler
    LOADI r0, #0, i32   ; pc 38 — dead filler
    LOADI r0, #0, i32   ; pc 39 — dead filler
