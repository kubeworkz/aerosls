; jmpr_callret_arg.simi — M2.20: the call-site-aware extension of M2.19.
; The leaf returns arg0 + arg1, and TWO call sites call it with different
; compile-time constant args, pinning the call-site-DEPENDENT analysis
; (per-site independence, not just args-seeding): main passes 3 + 5 = 8
; (JMPR folds to pc 8), other passes 8 + 10 = 18 (JMPR folds to pc 18).
; M2.19's per-callee analysis (args unknown under the fresh-frame map)
; cannot fold either: the callee's r0 depends on registers that are
; unknown inside the leaf. M2.20 runs the same ar_const_step body walk AT
; EACH CALL SITE, seeding the scratch map's r0-r7 from the CALLER's
; constant map — the emitted call site marshals r0-r7 from the caller's
; frame (and the interpreter copies them), so a known constant argument
; is a known constant inside the leaf. pc 7 / pc 17 are unreachable
; filler: both fold targets are NOT pc+1, so both folds are REAL branches
; (the coalescing pre-pass does not fire; rule 1 marks pc 8 and pc 18).
; Because g_alloc requires EVERY JMPR in the stream to fold, the second
; caller's fold is load-bearing: if either call site failed to fold, the
; whole program would fall back to the naive path.
; Expected result: 9 (main: pc 8's ADD r0, r0, #1 -> 8 + 1).
.entry main
main:
    ENTER #8            ; pc 0
    LOADI r2, #3, i64   ; pc 1 — arg0 seed
    LOADI r3, #5, i64   ; pc 2 — arg1 seed
    MOV r0, r2, i64     ; pc 3 — arg0 = 3
    MOV r1, r3, i64     ; pc 4 — arg1 = 5
    CALL leaf           ; pc 5 — r0 = 3 + 5 = 8 after the call (M2.20)
    JMPR r0             ; pc 6 — r0 = 8 — folds to pc 8 (a real branch)
    LOADI r9, #99, i64  ; pc 7 — unreachable filler (never dispatched to)
target:                 ; pc 8 — reached only via the fold
    ADD r0, r0, #1, i64 ; pc 8 — r0 = 8 + 1 = 9
    RET                 ; pc 9 — returns 9
other:                  ; pc 10 — SECOND caller, SAME leaf, different args
    ENTER #8            ; pc 10
    LOADI r2, #8, i64   ; pc 11 — arg0 seed
    LOADI r3, #10, i64  ; pc 12 — arg1 seed
    MOV r0, r2, i64     ; pc 13 — arg0 = 8
    MOV r1, r3, i64     ; pc 14 — arg1 = 10
    CALL leaf           ; pc 15 — r0 = 8 + 10 = 18 after the call (M2.20)
    JMPR r0             ; pc 16 — r0 = 18 — folds to pc 18 (a DIFFERENT target)
    LOADI r9, #99, i64  ; pc 17 — unreachable filler
    ADD r0, r0, #1, i64 ; pc 18 — r0 = 18 + 1 = 19
    RET                 ; pc 19
leaf:                   ; pc 20 — the callee (a straight-line leaf)
    ENTER #8            ; pc 20 — fresh frame: r8+ zeroed, r0-r7 = caller args
    ADD r0, r0, r1, i64 ; pc 21 — r0 = arg0 + arg1
    RET                 ; pc 22
