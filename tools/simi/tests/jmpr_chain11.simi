block14:                ; pc 52
    LOADI r0, #1500, i32; pc 52
    RET                 ; pc 53
    LOADI r0, #0, i32   ; pc 54 — dead filler (aligns block15 to pc 56)
    LOADI r0, #0, i32   ; pc 55 — dead filler
block15:                ; pc 56
    LOADI r0, #1600, i32; pc 56
    RET                 ; pc 57
block16:                ; pc 58
    LOADI r0, #1700, i32; pc 58
    RET                 ; pc 59
