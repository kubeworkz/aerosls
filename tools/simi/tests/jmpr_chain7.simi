    LOADI r0, #0, i32   ; pc 49
    LOADI r0, #0, i32   ; pc 50
    LOADI r0, #0, i32   ; pc 51
block5:                 ; pc 52
    LOADI r0, #666, i32 ; pc 52
    RET                 ; pc 53
block6:                 ; pc 54
    LOADI r0, #777, i32 ; pc 54
    RET                 ; pc 55
