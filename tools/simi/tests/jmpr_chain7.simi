    RET                 ; pc 59
block9:                 ; pc 60
    LOADI r0, #1000, i32; pc 60
    RET                 ; pc 61
    LOADI r0, #0, i32   ; pc 62 — dead filler (aligns block10 to pc 84)
    LOADI r0, #0, i32   ; pc 63
    LOADI r0, #0, i32   ; pc 64
    LOADI r0, #0, i32   ; pc 65
    LOADI r0, #0, i32   ; pc 66
