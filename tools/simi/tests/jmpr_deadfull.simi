; jmpr_deadfull.simi — M2.23: whole-body DEAD-CODE ELIMINATION.
; `deadfull` (pc 10) is an unreachable function with a rich body: an
; arithmetic chain (LOADI/LOADI/ADD/MUL — r4 = (10+20)*20 = 600, known
; to the fixpoint), a CALL to the leaf, a BR to a second block, and a
; JMPR whose index 600 is OUT OF RANGE (num_instr = 22) — so it can
; never fold and its dynamic table path (bounds check + table lookup +
; UDF) would be emitted as dead code. M2.23 drops the ENTIRE function —
; the frame load, the arithmetic, the CALL site, the branches, the
; dynamic path — AND, because that was the only dynamic JMPR in the
; stream, the whole JMPR jump table (num_instr x 8 bytes) disappears
; with it: under g_alloc=1 every EMITTED JMPR folds, so no table is
; ever needed. main is unchanged: its JMPR (r0 = 8 after the M2.20
; leaf call) folds to pc 8, the runtime terminates, and the result is
; 9. 1352 bytes below its M0 baseline, and disabling the elimination
; grows it back to exactly 3204 (the M2.21 emission, still correct) —
; the teeth, isolating the 1240-byte elimination delta (the dead body
; + the 176-byte table). The four dead-code rows now all land on the
; same 1964-byte live core: dead bodies and tables are simply not
; there.
; Expected result: 9 (pc 8: ADD r0, r0, #1 -> 8 + 1).
.entry main
main:
    ENTER #8            ; pc 0
    LOADI r2, #3, i64   ; pc 1 — arg0 seed
    LOADI r3, #5, i64   ; pc 2 — arg1 seed
    MOV r0, r2, i64     ; pc 3 — arg0 = 3
    MOV r1, r3, i64     ; pc 4 — arg1 = 5
    CALL leaf           ; pc 5 — r0 = 3 + 5 = 8 after the call (M2.20)
    JMPR r0             ; pc 6 — r0 = 8 — folds to pc 8 (a real branch)
    LOADI r9, #99, i64  ; pc 7 — unreachable filler
target:                 ; pc 8 — reached only via the fold
    ADD r0, r0, #1, i64 ; pc 8 — r0 = 8 + 1 = 9
    RET                 ; pc 9 — returns 9
deadfull:               ; pc 10 — UNREACHABLE function (M2.23)
    ENTER #8            ; pc 10
    LOADI r4, #10, i64  ; pc 11 — arithmetic chain: r4 = (10 + 20) * 20 = 600
    LOADI r5, #20, i64  ; pc 12
    ADD r4, r4, r5, i64 ; pc 13
    MUL r4, r4, r5, i64 ; pc 14
    CALL leaf           ; pc 15 — a CALL site inside dead code
    BR skip             ; pc 16 — a branch inside dead code
skip:                   ; pc 17 — a second dead block
    JMPR r4             ; pc 17 — r4 = 600 >= num_instr (22) — NEVER folds — dynamic
    RET                 ; pc 18
leaf:                   ; pc 19 — the callee (a straight-line leaf)
    ENTER #8            ; pc 19 — fresh frame: r8+ zeroed, r0-r7 = caller args
    ADD r0, r0, r1, i64 ; pc 20 — r0 = arg0 + arg1
    RET                 ; pc 21
