      (let* ((in-ptr    (aerosls:arena-mem input-cap))
             (out-cap   (aerosls:arena-alloc (* count 8)
                        :rights '(:read :write)))   ; arena ownership: returned to caller
             (out-ptr   (aerosls:arena-mem out-cap)))
