(defun calculator-matmul-vec (matrix-cap rows cols v)
  "matmul_vec(m: MatrixData@arena, v: Vec2@borrowed) -> Result<Vec2, CalcError>
   The matrix elements live in shared arena memory (accessed via MEM cap).
   The vector arrives inline. The result is computed and returned inline."
  (declare (type (unsigned-byte 16) matrix-cap)
           (type (unsigned-byte 32) rows cols)
           (type vec2 v))
