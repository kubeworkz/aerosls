(defun calculator-add (a b)
  "add(a: i32, b: i32) -> Result<i32, CalcError>
   Pure in-register arithmetic. Both args and the result fit in
   the 8-byte request/reply payload — no arena allocation needed."
  (declare (type (unsigned-byte 32) a b))
  (handler-case
      (calc-success (ldb (byte 32 0) (+ a b)))
    (arithmetic-error (e)
      (calc-failure :overflow
                    (format nil "add overflow: ~A" e)))))

(defun calculator-div (a b)
  "div(a: i64, b: i64) -> Result<i64, CalcError>"
  (declare (type (signed-byte 64) a b))
  (if (zerop b)
      (calc-failure :division-by-zero "division by zero")
      (handler-case
          (calc-success (truncate a b))
        (arithmetic-error (e)
          (calc-failure :overflow
                        (format nil "div overflow: ~A" e))))))

(defun calculator-dot (a b)
