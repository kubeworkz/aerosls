    (return-from calculator-matmul-vec
      (calc-failure :invalid-input "matrix must have exactly 2 columns")))
  ;; Zero-copy read: the arena MEM cap maps directly into our address space
  (let* ((ptr  (aerosls:arena-mem matrix-cap))
         (r00  (cffi:mem-aref ptr :double 0))
         (r01  (cffi:mem-aref ptr :double 1))
         (r10  (cffi:mem-aref ptr :double 2))
         (r11  (cffi:mem-aref ptr :double 3))
         (x    (+ (* r00 (vec2-x v)) (* r01 (vec2-y v))))
         (y    (+ (* r10 (vec2-x v)) (* r11 (vec2-y v)))))
    (calc-success (make-vec2 x y))))

